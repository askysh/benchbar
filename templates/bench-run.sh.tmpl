#!/bin/bash
#@version 6
#@unhashed CLI_VERSION
# __HEADER__
#
# Generated by benchbar. Do not edit by hand: run "benchbar repair".
#
# Starts the bench under honcho from the launchd agent __LABEL__.
# Crash guard: at most __MAX_STARTS__ starts in __WINDOW__ seconds, then
# auto-restart pauses (stop flag "crash") and a notification is shown.
# The stop flag "manual" is written by "benchbar down" (benchdown).
#
# Every transition is written to logs/.benchbar/state.json (temp file, then
# mv) for the BenchBar app. The format is docs/json-schema.md, schema 1.
# While honcho runs, logs/.benchbar/heartbeat is rewritten in place every
# 30 seconds: its mtime tells the app this runner is alive.

BENCH="__BENCH_DIR__"
HONCHO="__HONCHO__"
PORTS="__PORTS__"
SITE="__SITE__"
WEB_PORT="__WEB_PORT__"
MAX_STARTS=__MAX_STARTS__
WINDOW=__WINDOW__
STOPFLAG="$BENCH/logs/.bench-stopped"
HIST="$BENCH/logs/.bench-starts"
LOG="$BENCH/logs/bench.log"
STATE_DIR="$BENCH/logs/.benchbar"
STATE="$STATE_DIR/state.json"
PING_TRIES="${BENCHBAR_PING_TRIES:-120}"
PING_EVERY="${BENCHBAR_PING_EVERY:-2}"
HEARTBEAT="$STATE_DIR/heartbeat"
HEARTBEAT_EVERY="${BENCHBAR_HEARTBEAT_EVERY:-30}"

cd "$BENCH" || exit 0
mkdir -p "$BENCH/logs" 2>/dev/null

jstr() { if [ -n "$1" ]; then printf '"%s"' "$1"; else printf 'null'; fi; }
jnum() { case "$1" in ''|*[!0-9-]*) printf 'null' ;; *) printf '%s' "$1" ;; esac; }

# write_state STATE STOP_REASON PID STARTED_AT LAST_EXIT PING
write_state() {
  mkdir -p "$STATE_DIR" 2>/dev/null
  tmp="$(mktemp "$STATE_DIR/.state.json.XXXXXX" 2>/dev/null)" || return 0
  printf '{"schema_version":1,"cli_version":"__CLI_VERSION__","bench":"%s","name":"__BENCH_NAME__","site":"%s","label":"__LABEL__","state":"%s","stop_reason":%s,"pid":%s,"started_at":%s,"last_exit_code":%s,"web_url":"http://%s:%s","web_ping_code":%s,"updated_at":"%s","source":"runner"}\n' \
    "$BENCH" "$SITE" "$1" "$(jstr "$2")" "$(jnum "$3")" "$(jstr "$4")" "$(jnum "$5")" "$SITE" "$WEB_PORT" "$(jnum "$6")" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$tmp" 2>/dev/null || return 0
  # BENCHBAR_STATE_LOG keeps every transition (tests and debugging only)
  [ -n "${BENCHBAR_STATE_LOG:-}" ] && cat "$tmp" >>"$BENCHBAR_STATE_LOG" 2>/dev/null
  mv -f "$tmp" "$STATE" 2>/dev/null
}

# beat: the heartbeat, in place (no temp file, no mv): a write inside an
# existing file changes no folder entry, so it wakes no folder watcher, and
# costs no process. The content is this runner's age in seconds.
beat() { printf '%s\n' "$SECONDS" >"$HEARTBEAT" 2>/dev/null; }

prev_exit() {
  sed -n 's/.*"last_exit_code":\([0-9-]*\).*/\1/p' "$STATE" 2>/dev/null
}

# the macOS notification is a fallback for people who do not run the app
notify() {
  pgrep -xq BenchBar 2>/dev/null && return 0
  osascript -e "display notification \"$1\" with title \"BenchBar: __BENCH_NAME__\"" >/dev/null 2>&1
}

# stopped on purpose (benchdown) or paused after repeated crashes
if [ -f "$STOPFLAG" ]; then
  reason="$(tr -d '[:space:]' <"$STOPFLAG")"
  case "$reason" in
    manual) write_state stopped manual "" "" "$(prev_exit)" "" ;;
    *) write_state paused "${reason:-crash}" "" "" "$(prev_exit)" "" ;;
  esac
  exit 0
fi

if [ ! -x "$HONCHO" ]; then
  echo "$(date '+%F %T') honcho missing at $HONCHO; run: benchbar repair" >> "$LOG"
  echo "broken" > "$STOPFLAG"
  write_state paused broken "" "" "$(prev_exit)" ""
  notify "honcho is missing. Run benchbar repair, then benchup."
  exit 0
fi
if [ ! -x "$BENCH/env/bin/python" ]; then
  echo "$(date '+%F %T') env/bin/python missing; run: benchbar repair" >> "$LOG"
  echo "broken" > "$STOPFLAG"
  write_state paused broken "" "" "$(prev_exit)" ""
  notify "The bench env is missing. Run benchbar repair, then benchup."
  exit 0
fi

# crash guard: at most MAX_STARTS starts inside WINDOW seconds. The guard
# fails closed: when the start history or the stop flag cannot be written
# (a full disk, a folder gone read only) nothing would ever stop launchd's
# restarts, so the runner pauses with "broken" instead of starting.
broken() {
  echo "$(date '+%F %T') $1; run: benchbar doctor" >> "$LOG" 2>/dev/null
  echo "broken" > "$STOPFLAG" 2>/dev/null
  write_state paused broken "" "" "$(prev_exit)" ""
  notify "$2"
  exit 0
}
now=$(date +%s)
touch "$HIST" 2>/dev/null || broken "cannot write $HIST" "The bench's logs folder is not writable. Run benchbar doctor."
# the stop flag must be writable too: it is how a crash loop is stopped
( : >> "$STOPFLAG.probe" && rm -f "$STOPFLAG.probe" ) 2>/dev/null || broken "cannot write $STOPFLAG" "The bench's logs folder is not writable. Run benchbar doctor."
if awk -v n="$now" -v w="$WINDOW" '(n - $1) < w' "$HIST" > "$HIST.tmp" 2>/dev/null; then
  mv -f "$HIST.tmp" "$HIST" 2>/dev/null || broken "cannot update $HIST" "The crash guard cannot keep its history. Run benchbar doctor."
else
  rm -f "$HIST.tmp"
  broken "cannot read or update $HIST" "The crash guard cannot keep its history. Run benchbar doctor."
fi
echo "$now" >> "$HIST" 2>/dev/null || broken "cannot append to $HIST" "The crash guard cannot keep its history. Run benchbar doctor."
if [ "$(wc -l < "$HIST" | tr -d ' ')" -gt "$MAX_STARTS" ]; then
  echo "$(date '+%F %T') crashed $MAX_STARTS times in $((WINDOW / 60)) min, auto-restart paused" >> "$LOG"
  echo "crash" > "$STOPFLAG"
  : > "$HIST"
  write_state paused crash "" "" "$(prev_exit)" ""
  notify "Crashed $MAX_STARTS times in $((WINDOW / 60)) minutes. Auto-restart paused. Run benchlogs, fix, then benchup."
  exit 0
fi

# clear leftovers of this bench from a previous crash so the ports are free.
# Only a process whose working folder is this bench is ours to stop: another
# bench's redis, web or socketio and any other program on the same ports
# stay, and so does a process whose folder cannot be read (no proof).
is_ours() {
  case "$(lsof -a -p "$1" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -n1)" in
    "$BENCH"|"$BENCH"/*) return 0 ;;
  esac
  return 1
}
pkill -f "^__BENCH_RE__/env/bin/python -m frappe.utils.bench_helper frappe (serve|worker|schedule)" 2>/dev/null
# socketio runs as "node apps/frappe/socketio.js" in every bench
for pid in $(pgrep -f "apps/frappe/socketio.js" 2>/dev/null); do
  is_ours "$pid" && "${BENCHBAR_KILL_CMD:-kill}" "$pid" 2>/dev/null
done
for pid in $(lsof -ti "tcp:$PORTS" -sTCP:LISTEN 2>/dev/null); do
  is_ours "$pid" && "${BENCHBAR_KILL_CMD:-kill}" "$pid" 2>/dev/null
done
# a port still held after that is not this bench's to free: honcho would only
# fail to bind and trip the crash guard, so pause with the reason instead
i=0; held=""
while [ "$i" -lt 5 ]; do
  held="$(lsof -ti "tcp:$PORTS" -sTCP:LISTEN 2>/dev/null | tr '\n' ' ')"
  [ -n "$held" ] || break
  sleep 1
  i=$((i + 1))
done
if [ -n "$held" ]; then
  echo "$(date '+%F %T') ports $PORTS are held by processes that are not this bench's (pid ${held% }); run: benchbar doctor" >> "$LOG"
  echo "port_conflict" > "$STOPFLAG"
  write_state paused port_conflict "" "" "$(prev_exit)" ""
  notify "Another program holds this bench's ports. Run benchbar doctor, then benchup."
  exit 0
fi

echo "$(date '+%F %T') starting bench (__LABEL__)" >> "$LOG"
started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
# honcho runs as a child (not exec) so this script sees it exit and can
# record the transition. launchd signals this script; forward to honcho.
"$HONCHO" start -f Procfile.lean &
HPID=$!
TERMED=0
trap 'TERMED=1; kill -TERM "$HPID" 2>/dev/null' TERM INT HUP
# the first beat before "starting": a reader of state.json finds it fresh
mkdir -p "$STATE_DIR" 2>/dev/null
beat
write_state starting "" "$$" "$started" "" ""

# one background ping loop marks the bench running once the site answers
# ($$ in a subshell is still this runner's pid)
(
  i=0
  while [ "$i" -lt "$PING_TRIES" ]; do
    sleep "$PING_EVERY"
    kill -0 "$HPID" 2>/dev/null || exit 0
    code="$(curl -s -o /dev/null -m 2 -w '%{http_code}' -H "Host: $SITE" "http://127.0.0.1:$WEB_PORT/api/method/ping" 2>/dev/null)"
    if [ "$code" = "200" ]; then
      kill -0 "$HPID" 2>/dev/null && write_state running "" "$$" "$started" "" 200
      exit 0
    fi
    i=$((i + 1))
  done
) &
PINGER=$!

# the heartbeat loop, for as long as honcho runs. sleep runs as a child the
# loop waits for, so a TERM ends the loop at once and takes the sleep along.
(
  s=""
  trap 'kill "$s" 2>/dev/null; exit 0' TERM
  while :; do
    sleep "$HEARTBEAT_EVERY" &
    s=$!
    wait "$s"
    kill -0 "$HPID" 2>/dev/null || exit 0
    beat
  done
) &
BEATER=$!

code=0
while :; do
  wait "$HPID"
  code=$?
  kill -0 "$HPID" 2>/dev/null || break
done
if [ "$TERMED" = "1" ]; then
  # the first wait may have been cut short by the trap; fetch the real status
  wait "$HPID" 2>/dev/null
  last=$?
  [ "$last" != "127" ] && code=$last
fi
kill "$PINGER" 2>/dev/null
wait "$PINGER" 2>/dev/null
kill "$BEATER" 2>/dev/null
wait "$BEATER" 2>/dev/null

if [ -f "$STOPFLAG" ]; then
  reason="$(tr -d '[:space:]' <"$STOPFLAG")"
  case "$reason" in
    manual) write_state stopped manual "" "$started" "$code" "" ;;
    *) write_state paused "${reason:-crash}" "" "$started" "$code" "" ;;
  esac
  exit 0
fi
if [ "$TERMED" = "1" ]; then
  # restart, logout or shutdown: not a crash
  write_state stopped "" "" "$started" "$code" ""
  exit 0
fi
# Without a stop flag and without a signal, no exit of honcho is a stop the
# person asked for: honcho leaves with the code of the first child that
# ended, and a redis that took a TERM from elsewhere ends with 0. That used
# to look like a clean stop (no restart, no word, the bench back only at
# the next login). It is a crash: say so, and exit non-zero so launchd
# restarts the bench under the crash guard.
if [ "$code" = "0" ]; then
  echo "$(date '+%F %T') honcho exited with code 0 without a stop request (a process of the bench ended); restarting" >> "$LOG"
  write_state crashed crash "" "$started" 0 ""
  exit 1
fi
echo "$(date '+%F %T') honcho exited with code $code" >> "$LOG"
write_state crashed crash "" "$started" "$code" ""
exit "$code"
