#!/bin/bash
#@version 1
# __HEADER__
#
# Generated by frappe-mac. Do not edit by hand: run "frappe-mac repair".
#
# Starts the bench under honcho from the launchd agent __LABEL__.
# Crash guard: at most __MAX_STARTS__ starts in __WINDOW__ seconds, then
# auto-restart pauses (stop flag "crash") and a notification is shown.
# The stop flag "manual" is written by "frappe-mac down" (benchdown).

BENCH="__BENCH_DIR__"
HONCHO="__HONCHO__"
PORTS="__PORTS__"
MAX_STARTS=__MAX_STARTS__
WINDOW=__WINDOW__
STOPFLAG="$BENCH/logs/.bench-stopped"
HIST="$BENCH/logs/.bench-starts"
LOG="$BENCH/logs/bench.log"

cd "$BENCH" || exit 0
mkdir -p "$BENCH/logs" 2>/dev/null

# stopped on purpose (benchdown) or paused after repeated crashes
[ -f "$STOPFLAG" ] && exit 0

notify() {
  osascript -e "display notification \"$1\" with title \"Frappe bench: __BENCH_NAME__\"" >/dev/null 2>&1
}

if [ ! -x "$HONCHO" ]; then
  echo "$(date '+%F %T') honcho missing at $HONCHO; run: frappe-mac repair" >> "$LOG"
  echo "broken" > "$STOPFLAG"
  notify "honcho is missing. Run frappe-mac repair, then benchup."
  exit 0
fi
if [ ! -x "$BENCH/env/bin/python" ]; then
  echo "$(date '+%F %T') env/bin/python missing; run: frappe-mac repair" >> "$LOG"
  echo "broken" > "$STOPFLAG"
  notify "The bench env is missing. Run frappe-mac repair, then benchup."
  exit 0
fi

# crash guard: at most MAX_STARTS starts inside WINDOW seconds
now=$(date +%s)
touch "$HIST"
awk -v n="$now" -v w="$WINDOW" '(n - $1) < w' "$HIST" > "$HIST.tmp" && mv "$HIST.tmp" "$HIST"
echo "$now" >> "$HIST"
if [ "$(wc -l < "$HIST" | tr -d ' ')" -gt "$MAX_STARTS" ]; then
  echo "$(date '+%F %T') crashed $MAX_STARTS times in $((WINDOW / 60)) min, auto-restart paused" >> "$LOG"
  echo "crash" > "$STOPFLAG"
  : > "$HIST"
  notify "Crashed $MAX_STARTS times in $((WINDOW / 60)) minutes. Auto-restart paused. Run benchlogs, fix, then benchup."
  exit 0
fi

# clear leftovers of this bench from a previous crash so the ports are free
pkill -f "^__BENCH_RE__/env/bin/python -m frappe.utils.bench_helper frappe (serve|worker|schedule)" 2>/dev/null
pkill -f "apps/frappe/socketio.js" 2>/dev/null
lsof -ti "tcp:$PORTS" -sTCP:LISTEN 2>/dev/null | xargs kill 2>/dev/null
sleep 1

echo "$(date '+%F %T') starting bench (__LABEL__)" >> "$LOG"
exec "$HONCHO" start -f Procfile.lean
