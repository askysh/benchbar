#@version 1
# __HEADER__
# Generated by benchbar share start (the systemd --user job of a share, on Linux). It lives in the
# runtime folder, is deleted when the share ends, and does not survive a logout or a reboot.
[Unit]
Description=BenchBar share gateway (benchbar share start)
# a stopped or failed job leaves nothing behind
CollectMode=inactive-or-failed
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=__SHARE_DIR__
ExecStart=/bin/bash "__RUNNER__"
ExecStopPost=-/bin/rm -f "__UNIT_FILE__"
Environment="PATH=__PATH__"
Environment=LANG=C.UTF-8
UMask=0077
# the runner decides when the share ends; nothing starts it again
Restart=no
# stop sends SIGTERM to the runner, whose trap ends its children and wipes the copy's sessions
KillMode=mixed
TimeoutStopSec=20
StandardOutput=append:__LOG__
StandardError=append:__LOG__
