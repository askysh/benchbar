#!/bin/bash
#@version 6
#@quoted SHARE_DIR SOCK BENCH SHARE_SITE WEB_PORT PYTHON LIB NODE BENCHBAR DNS_SD CAFFEINATE LSOF CURL SITE_LABEL ROOM_LABEL  # SESSIONS_PY and CONTROL_JS sit in quoted here-documents, where they are literal
# __HEADER__
#
# Generated by benchbar share start. Do not edit by hand.
#
# The runner of the launchd job com.benchbar-share.gateway. It starts, in this
# order, and ends the job (fail closed) when one of them cannot be trusted:
#   1. no gateway.json: exit 78. The copy's sessions are wiped before anything
#      starts: a runner killed with -9 never ran its trap.
#   2. the web process (share_web.py: 127.0.0.1 only, no debugger), until its
#      own PID listens on WEB_PORT; then one GET of its home page, bounded by
#      WARM_SECS, so the checks' short timeouts meet a warm Frappe (a cold one
#      takes seconds over a large copy's first request). Its result is only
#      logged: the checks decide.
#   3. the critical checks: any fail ends the job, and the gateway never starts
#   4. the gateway, until its control socket is there; the checks again (from
#      here gateway_reachable must be ok: a skip proves nothing), and only then
#      is the gateway told the web is up. It starts with the web down, answering
#      every proxied request with its "restarting" page.
#   5. dns-sd, and caffeinate for as long as this runner lives. Either one that
#      ends is started again after a backoff that doubles (BACKOFF_MIN to
#      BACKOFF_MAX polls) and resets once it has stayed up STABLE_POLLS. dns-sd
#      ending makes the share degraded until it has stayed up that long; it
#      never ends the share.
#   6. the watchdog: the checks FIRST_TICK polls in, then every EVERY polls (a
#      poll is POLL seconds); two fails in a row end the job. After a pass, a
#      gateway that latched the web down (a refused connect) is told up again
#      only while the web's own PID holds its port; a port someone else holds
#      stays down.
# The gateway exiting (stop, the deadline, a crash) ends the job. When the web
# process ends, the gateway is told the web is down first, then the web is
# started again (warmed as at the start) and the checks run; only a pass tells
# the gateway it is up again, and a fail ends the job. The 4th end of it in a
# row ends the job, where a web that stayed up WEB_HEALTHY_SECS after it was
# marked up starts the count again: deaths are counted, not timed, so slow
# restarts cannot spread them out of a window. A web op the gateway does not
# confirm ends the job.
# The phase file (PID PHASE) says how far a start has come, for share start's
# wait and share status: starting:wipe, starting:web, starting:checks,
# starting:gateway, running.
# The trap sends TERM to every child at once (each by the PID recorded when it
# started, and only while it is still this runner's child), KILLs what is left
# after 2 s, wipes the copy's sessions (at most WIPE_SECS) and removes the
# control socket, the job's plist, the phase file and this file. launchd sends
# SIGKILL 20 seconds after a bootout, so the trap stays well under that.
umask 077

SHARE_DIR="__SHARE_DIR__"
SOCK="__SOCK__"
BENCH="__BENCH__"
SHARE_SITE="__SHARE_SITE__"
WEB_PORT="__WEB_PORT__"
GATEWAY_PORT=__GATEWAY_PORT__
PYTHON="__PYTHON__"
LIB="__LIB__"
NODE="__NODE__"
BENCHBAR="__BENCHBAR__"
DNS_SD="__DNS_SD__"
CAFFEINATE="__CAFFEINATE__"
LSOF="__LSOF__"
CURL="__CURL__"
SITE_LABEL="__SITE_LABEL__"
ROOM_LABEL="__ROOM_LABEL__"
CONFIG="$SHARE_DIR/gateway.json"
PLIST="$SHARE_DIR/job.plist"
SELF="$SHARE_DIR/share-run.sh"
DEGRADED="$SHARE_DIR/degraded"
ENDED="$SHARE_DIR/ended"
PHASE="$SHARE_DIR/phase"
WIPE_FAILED="$SHARE_DIR/wipe_failed"
POLL="${BENCHBAR_SHARE_POLL:-1}"
FIRST_TICK="${BENCHBAR_SHARE_FIRST_TICK:-5}"
EVERY="${BENCHBAR_SHARE_EVERY:-60}"
STABLE_POLLS="${BENCHBAR_SHARE_STABLE_POLLS:-60}"
LISTEN_SECS="${BENCHBAR_SHARE_LISTEN_SECS:-__LISTEN_SECS__}"
WIPE_SECS=__WIPE_SECS__
SOCK_SECS=__SOCK_SECS__
WARM_SECS=__WARM_SECS__
WEB_RESTARTS_MAX=3
WEB_HEALTHY_SECS="${BENCHBAR_SHARE_WEB_HEALTHY_SECS:-300}"
BACKOFF_MIN=5
BACKOFF_MAX=300

IFS= read -r -d '' SESSIONS_PY <<'BENCHBAR_SESSIONS_PY'
__SESSIONS_PY__
BENCHBAR_SESSIONS_PY
IFS= read -r -d '' CONTROL_JS <<'BENCHBAR_CONTROL_JS'
__CONTROL_JS__
BENCHBAR_CONTROL_JS

GW_PID=""; WEB_PID=""; DNS_PID=""; CAF_PID=""; NAP_PID=""
LAST_FAILED=""; WEB_DEATHS=0; WEB_UP_AT=0
polls=0; DNS_NEXT=0; DNS_DELAY=0; DNS_SINCE=0; CAF_NEXT=0; CAF_DELAY=0; CAF_SINCE=0

say() { printf '%s share: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }
alive() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null; }
phase() { printf '%s %s\n' "$$" "$1" >"$PHASE"; }

# mine PID: PID is still a child of this runner, not a number something else has been given since
mine() {
  local ppid
  [ -n "$1" ] || return 1
  ppid="$(/bin/ps -o ppid= -p "$1" 2>/dev/null)"
  [ "${ppid//[[:space:]]/}" = "$$" ]
}

# stop_children: TERM to every child at once, one wait of about 2 s by the clock (a count of sleeps would
# stretch on a loaded machine, and launchd's SIGKILL comes 20 s after a bootout), then KILL to what is left
stop_children() {
  local pid live="" left end=$((SECONDS + 2))
  for pid in "$GW_PID" "$WEB_PID" "$DNS_PID" "$CAF_PID" "$NAP_PID"; do
    if mine "$pid"; then kill -TERM "$pid" 2>/dev/null; live="${live} ${pid}"; fi
  done
  while [ "$SECONDS" -lt "$end" ]; do
    left=""
    for pid in $live; do alive "$pid" && left="${left} ${pid}"; done
    [ -n "$left" ] || break
    sleep 0.1
  done
  for pid in $live; do
    if alive "$pid" && mine "$pid"; then kill -KILL "$pid" 2>/dev/null; fi
    wait "$pid" 2>/dev/null
  done
  GW_PID=""; WEB_PID=""; DNS_PID=""; CAF_PID=""; NAP_PID=""
}

# fail_job REASON MESSAGE: the reason is kept for benchbar share status
fail_job() {
  say "$2"
  printf '%s\t%s\n' "$1" "$2" >"$ENDED"
  exit 1
}

# wipe_sessions: the copy's sessions end, within WIPE_SECS by the clock (the trap runs it, under launchd's 20 s)
wipe_sessions() {
  local pid code=0 start="$SECONDS"
  [ -x "$PYTHON" ] || { say "cannot end the copy's sessions: ${PYTHON} is missing"; return 1; }
  ( cd "$BENCH/sites" && exec "$PYTHON" -c "$SESSIONS_PY" benchbar-share-sessions "$SHARE_SITE" ) </dev/null &
  pid=$!
  while alive "$pid" && [ "$SECONDS" -lt $((start + WIPE_SECS)) ]; do sleep 0.1; done
  if alive "$pid"; then
    kill -KILL "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
    say "ending the copy's sessions took more than ${WIPE_SECS} s"
    return 1
  fi
  wait "$pid" || code=$?
  if [ "$code" != 0 ]; then say "ending the copy's sessions failed (exit ${code})"; return "$code"; fi
  say "ended the copy's sessions ($((SECONDS - start)) s)"
  rm -f "$WIPE_FAILED"
}

cleanup() {
  trap '' TERM INT HUP
  stop_children
  rm -f "$SOCK" "$PLIST" "$DEGRADED" "$PHASE"
  wipe_sessions
  rm -f "$SELF"
}

# web_state up|down: the gateway confirms the web state, or the job ends
web_state() {
  "$NODE" -e "$CONTROL_JS" control "$SOCK" "{\"op\":\"web\",\"state\":\"$1\"}" </dev/null >/dev/null 2>&1 \
    || fail_job gateway "The gateway did not confirm that the web process is $1."
}

# web_owns_port: the web process itself (its PID, not whatever else holds the port) listens on WEB_PORT now
web_owns_port() {
  local pids nl='
'
  alive "$WEB_PID" || return 1
  pids="$("$LSOF" -ti "tcp:${WEB_PORT}" -sTCP:LISTEN 2>/dev/null)"
  case "${nl}${pids}${nl}" in *"${nl}${WEB_PID}${nl}"*) return 0 ;; esac
  return 1
}

# web_listening: until web_owns_port, for up to LISTEN_SECS
web_listening() {
  local i=0
  while [ "$i" -lt $((LISTEN_SECS * 5)) ]; do
    alive "$WEB_PID" || return 1
    web_owns_port && return 0
    sleep 0.2; i=$((i + 1))
  done
  return 1
}

# gateway_web_down: the gateway answers that it has the web marked down (no answer is not a yes)
gateway_web_down() {
  local out
  out="$("$NODE" -e "$CONTROL_JS" control "$SOCK" '{"op":"status"}' </dev/null 2>/dev/null)" || return 1
  case "$out" in *web_up=false*) return 0 ;; esac
  return 1
}

# web_up_held: tells the gateway the web is up, then checks again that the web's own PID still holds the
# port (it could lose it between the check before and the op); if not, the gateway is told down and the job ends
web_up_held() {
  web_state up
  web_owns_port && return 0
  web_state down
  fail_job web "The web process of the share stopped holding its port as it was marked up."
}

# rearm_web: after a passing check, a web the gateway latched down is marked up again when its own PID
# holds the port. A port held by something else stays down, said once until the web is up again.
FOREIGN_SAID=0
rearm_web() {
  gateway_web_down || return 0
  if web_owns_port; then
    web_up_held
    FOREIGN_SAID=0
    say "the gateway had marked the web down; its own process holds the port: marked the web up again"
  elif [ "$FOREIGN_SAID" = 0 ]; then
    FOREIGN_SAID=1
    say "the gateway has the web marked down, and the web process does not hold its port: it stays down"
  fi
}

# warm_web: one GET of the home page within WARM_SECS; only logged, the checks judge the web
warm_web() {
  local start="$SECONDS"
  if "$CURL" -s -o /dev/null -m "$WARM_SECS" -H "Host: ${SHARE_SITE}" "http://127.0.0.1:${WEB_PORT}/" </dev/null >/dev/null 2>&1; then
    say "the web answered its first request ($((SECONDS - start)) s)"
  else
    say "the web did not answer a first request within ${WARM_SECS} s; the checks decide"
  fi
}

start_web() {
  ( cd "$BENCH/sites" && exec /usr/bin/env -u DEV_SERVER CI=1 PYTHONDONTWRITEBYTECODE=1 "$PYTHON" "$LIB/share/share_web.py" --site "$SHARE_SITE" --port "$WEB_PORT" ) </dev/null &
  WEB_PID=$!
  web_listening || return 1
  warm_web
}

# checks AFTER_GATEWAY: the critical checks pass; with AFTER_GATEWAY 1, gateway_reachable must be ok as well.
# LAST_FAILED: the ids of the checks that failed. No answer, or one that cannot be read, is a fail.
checks() {
  local out code=0 rest re='"id":"([a-z_]+)","class":"[a-z]+","status":"fail"'
  out="$(FL_STATE_DIR="${SHARE_DIR%/share}" FL_SHARE_CONTROL_SOCK="$SOCK" FL_SHARE_NODE="$NODE" \
    "$BENCHBAR" share preflight --json --critical --quiet --bench-dir "$BENCH" </dev/null)" || code=$?
  LAST_FAILED=""; rest="$out"
  while [[ "$rest" =~ $re ]]; do
    LAST_FAILED="${LAST_FAILED}${LAST_FAILED:+, }${BASH_REMATCH[1]}"
    rest="${rest#*"${BASH_REMATCH[0]}"}"
  done
  [ "$code" = 0 ] || return 1
  case "$out" in *'"ok":true'*) ;; *) return 1 ;; esac
  if [ "$1" = 1 ]; then
    case "$out" in
      *'"id":"gateway_reachable","class":"critical","status":"ok"'*) ;;
      *) LAST_FAILED="${LAST_FAILED:-gateway_reachable}"; return 1 ;;
    esac
  fi
  return 0
}

start_gateway() {
  local i=0
  rm -f "$SOCK"
  "$NODE" "$LIB/share/gateway.js" "$CONFIG" </dev/null &
  GW_PID=$!
  while [ "$i" -lt $((SOCK_SECS * 10)) ]; do
    alive "$GW_PID" || return 1
    [ -S "$SOCK" ] && return 0
    sleep 0.1; i=$((i + 1))
  done
  return 1
}

# start_dns [again]: the TXT record is for display only: no fingerprint, never the code. A start again is
# logged by its backoff line alone.
start_dns() {
  "$DNS_SD" -R "$ROOM_LABEL" _benchbar-share._tcp local "$GATEWAY_PORT" v=3 "label=${ROOM_LABEL}" "site=${SITE_LABEL}" </dev/null &
  DNS_PID=$!
  DNS_SINCE=$polls
  [ -n "${1:-}" ] || say "dns-sd started (pid ${DNS_PID})"
}

start_caffeinate() {
  "$CAFFEINATE" -i -w "$$" </dev/null &
  CAF_PID=$!
  CAF_SINCE=$polls
  [ -n "${1:-}" ] || say "caffeinate started (pid ${CAF_PID})"
}

# backoff_next DELAY SINCE: the polls to wait before starting again a child that started at poll SINCE and
# ended now: BACKOFF_MIN after a child that had stayed up STABLE_POLLS, else twice DELAY, at most BACKOFF_MAX
backoff_next() {
  local next
  if [ $((polls - $2)) -ge "$STABLE_POLLS" ]; then printf '%s' "$BACKOFF_MIN"; return 0; fi
  next=$(($1 * 2))
  [ "$next" -ge "$BACKOFF_MIN" ] || next="$BACKOFF_MIN"
  [ "$next" -le "$BACKOFF_MAX" ] || next="$BACKOFF_MAX"
  printf '%s' "$next"
}

restart_web() {
  [ $((SECONDS - WEB_UP_AT)) -lt "$WEB_HEALTHY_SECS" ] || WEB_DEATHS=0
  WEB_DEATHS=$((WEB_DEATHS + 1))
  [ "$WEB_DEATHS" -le "$WEB_RESTARTS_MAX" ] \
    || fail_job web "The web process of the share ended ${WEB_DEATHS} times in a row, never staying up $((WEB_HEALTHY_SECS / 60)) minutes in between."
  say "the web process ended (${WEB_DEATHS} in a row); starting it again"
  start_web || fail_job web "The web process of the share did not start again."
  checks 1 || fail_job checks "The checks failed after the web process started again: ${LAST_FAILED:-no answer}."
}

# web_gone: the web process has ended. The gateway is told first, so nothing reaches whatever takes its port.
web_gone() {
  wait "$WEB_PID" 2>/dev/null
  WEB_PID=""
  web_state down
  restart_web
  # as at the first start: the checks passed, and the new web still lives and holds its port
  web_owns_port || fail_job web "The web process of the share ended, or does not hold its port, after it started again."
  web_up_held
  WEB_UP_AT=$SECONDS
}

trap 'exit 0' TERM INT HUP
trap cleanup EXIT
rm -f "$ENDED" "$DEGRADED"
[ -f "$CONFIG" ] || { say "there is no ${CONFIG}: nothing to share"; exit 78; }
phase starting:wipe
wipe_sessions || fail_job sessions "The copy's sessions could not be ended, so sharing did not start."
phase starting:web
start_web || fail_job web "The web process of the share did not listen on 127.0.0.1:${WEB_PORT}."
phase starting:checks
checks 0 || fail_job checks "The checks failed before the gateway started: ${LAST_FAILED:-no answer}."
phase starting:gateway
start_gateway || fail_job gateway "The gateway did not start."
checks 1 || fail_job checks "The checks failed once the gateway was up: ${LAST_FAILED:-no answer}."
alive "$WEB_PID" || fail_job web "The web process of the share ended while it was checked."
web_up_held
WEB_UP_AT=$SECONDS
phase running
start_dns
start_caffeinate
say "sharing ${SHARE_SITE} as ${ROOM_LABEL}"

fails=0; next_tick="$FIRST_TICK"
while :; do
  sleep "$POLL" &
  NAP_PID=$!
  wait "$NAP_PID"
  NAP_PID=""
  polls=$((polls + 1))
  if ! alive "$GW_PID"; then
    code=0; wait "$GW_PID" || code=$?
    GW_PID=""
    [ "$code" = 0 ] || fail_job gateway "The gateway stopped (exit ${code})."
    say "the gateway ended"
    exit 0
  fi
  alive "$WEB_PID" || web_gone
  if [ -n "$DNS_PID" ] && ! alive "$DNS_PID"; then
    wait "$DNS_PID" 2>/dev/null
    DNS_PID=""
    DNS_DELAY="$(backoff_next "$DNS_DELAY" "$DNS_SINCE")"
    DNS_NEXT=$((polls + DNS_DELAY))
    printf '%s\n' "Rooms on this Wi-Fi may not list this room for a moment: Bonjour stopped and was started again." >"$DEGRADED"
    say "dns-sd ended; starting it again in ${DNS_DELAY} polls"
  fi
  if [ -z "$DNS_PID" ] && [ "$polls" -ge "$DNS_NEXT" ]; then start_dns again; fi
  if [ -n "$DNS_PID" ] && [ -f "$DEGRADED" ] && [ $((polls - DNS_SINCE)) -ge "$STABLE_POLLS" ]; then
    say "dns-sd has stayed up for ${STABLE_POLLS} polls: no longer degraded"
    rm -f "$DEGRADED"
  fi
  if [ -n "$CAF_PID" ] && ! alive "$CAF_PID"; then
    wait "$CAF_PID" 2>/dev/null
    CAF_PID=""
    CAF_DELAY="$(backoff_next "$CAF_DELAY" "$CAF_SINCE")"
    CAF_NEXT=$((polls + CAF_DELAY))
    say "caffeinate ended; starting it again in ${CAF_DELAY} polls"
  fi
  if [ -z "$CAF_PID" ] && [ "$polls" -ge "$CAF_NEXT" ]; then start_caffeinate again; fi
  if [ "$polls" -ge "$next_tick" ]; then
    next_tick=$((polls + EVERY))
    if checks 1; then
      fails=0
      rearm_web
    elif ! alive "$WEB_PID"; then
      # the web ended while it was checked: that is a restart, not a failed tick
      web_gone
    else
      fails=$((fails + 1))
      say "the checks failed (${fails} in a row): ${LAST_FAILED:-no answer}"
      [ "$fails" -lt 2 ] || fail_job checks "The checks failed twice in a row: ${LAST_FAILED:-no answer}."
    fi
  fi
done
