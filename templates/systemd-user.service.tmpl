#@version 1
# __HEADER__
# Generated by benchbar. Do not edit by hand: run "benchbar repair".
# benchbar-label: __LABEL__
# benchbar-autostart: __RUN_AT_LOAD__
[Unit]
Description=BenchBar bench __BENCH_NAME__
# the runner's crash guard decides when to stop restarting, not systemd
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=__BENCH_DIR__
ExecStart=/bin/bash "__RUNNER__"
Environment="PATH=__PATH__"
Environment=NO_PROXY=*
Environment=LANG=C.UTF-8
# a clean exit (stop flag, SIGTERM) stays stopped, any other exit restarts
# after 20 seconds, as the Mac agent does
Restart=on-failure
RestartSec=20
# a stop sends SIGTERM to the runner, which forwards it to honcho; whatever
# is left in the unit's group after the runner exits is killed
KillMode=mixed
TimeoutStopSec=30
StandardOutput=append:__LOG__
StandardError=append:__LOG__

[Install]
WantedBy=default.target
