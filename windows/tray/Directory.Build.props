<Project>
  <!-- Common settings for every project of the Windows tray app. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGetAudit warns about a package with a known vulnerability (NU1901 low to NU1904 critical). A new advisory must show in the build, but must not stop a release with no code change: Dependabot proposes the update. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <!-- Not invariant: the Fluent ScrollViewer template asks for a specific culture and fails with "Cannot find non-neutral culture related to 'en-us'" (see DECISIONS.md). -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- English resources only: no satellite assemblies of the WPF and Fluent libraries ship. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- Measurement hooks (the harness pipe, the logon log, a forced theme) exist in Debug builds only: they are not in what ships. -->
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <DefineConstants>$(DefineConstants);HARNESS</DefineConstants>
  </PropertyGroup>
</Project>
