<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BenchBarTray\BenchBarTray.csproj" />
    <ProjectReference Include="..\Tray.Core\Tray.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- One fixture lookup for both test projects (compiled into each). -->
    <Compile Include="..\Tray.Core.Tests\FixtureFiles.cs" Link="FixtureFiles.cs" />
    <!-- Fixtures travel with the test binaries, so a build with an artifacts path elsewhere still finds them. -->
    <None Include="..\fixtures\**\*" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
