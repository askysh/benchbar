# Line endings that must not change on a checkout, on any OS. These are the
# files that run on Linux, macOS and in WSL (a CRLF breaks a shell script) and
# install.ps1, which is served raw from GitHub with LF endings. Existing files
# already have these endings, so nothing is renormalized.
*.sh text eol=lf
*.tmpl text eol=lf
*.ps1 text eol=lf
/benchbar text eol=lf
/install.sh text eol=lf
/templates/** text eol=lf
*.tsv text eol=lf
*.toml text eol=lf

# The seconds per test: one row per test. Two branches that each add or change a row
# merge without a conflict (both rows are kept; scripts/ci-timings.sh --write leaves
# one). Git on a developer machine applies this; GitHub's merge button does not.
/tests/timings.tsv text eol=lf merge=union
