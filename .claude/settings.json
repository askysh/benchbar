{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "subagentPromptCacheTtl": "1h",
  "permissions": {
    "allow": [
      "Bash(bash tests/run-tests.sh)",
      "Bash(bash tests/run-tests.sh *)",
      "Bash(./benchbar)",
      "Bash(./benchbar *)",
      "Bash(benchbar *)",
      "Bash(shellcheck *)",
      "Bash(apt-get *)",
      "Bash(systemctl --user *)",
      "Bash(journalctl --user *)",
      "Bash(uv *)",
      "Bash(fnm *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(yarn *)",
      "Bash(bench *)",
      "Bash(mariadb *)",
      "Bash(redis-cli *)",
      "Bash(ss *)",
      "Bash(curl * http://localhost*)",
      "Bash(curl * http://127.0.0.1*)",
      "Bash(curl * http://*.localhost:*)",
      "Bash(curl http://localhost*)",
      "Bash(curl http://127.0.0.1*)",
      "Bash(curl http://*.localhost:*)",
      "Bash(python3 *)",
      "Bash(grep *)",
      "Bash(sed -n *)",
      "Bash(awk *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(cmp *)",
      "Bash(find *)",
      "Bash(sort *)",
      "Bash(getent *)",
      "Bash(dpkg-query *)",
      "Bash(dpkg-deb *)",
      "Bash(sha256sum *)",
      "Bash(systemd-analyze *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(gh run download *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr status)",
      "Bash(gh api repos/*)",
      "Bash(gh api -X POST repos/*/pulls/*/ccr/comments/*/resolve)",
      "Bash(gh api --method POST repos/*/pulls/*/ccr/comments/*/resolve)",
      "Bash(gh api -X POST repos/askysh/benchbar/pulls/*/comments/*/replies -F body=@*)",
      "Bash(gh api -X POST repos/askysh/benchbar/pulls/*/comments/*/replies -F body=@* --silent)",
      "Bash(gh api graphql -F query=@*)",
      "Bash(git *)",
      "Bash(go *)",
      "Bash(gofmt *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(dotnet *)",
      "Bash(wsl.exe -d Ubuntu-24.04 -- benchbar *)",
      "Bash(wsl.exe --list*)",
      "Bash(wsl.exe --status)",
      "Bash(schtasks /Query*)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git -C * push*)",
      "Bash(git -c * push*)",
      "Bash(git --no-pager push*)",
      "Bash(git tag *)",
      "Bash(git -C * tag*)",
      "Bash(git -c * tag*)",
      "Bash(git --no-pager tag*)",
      "Bash(gh api * merge*)",
      "Bash(gh api * git/refs*)",
      "Bash(gh api -X DELETE repos/askysh/*)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo edit *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh run rerun *)",
      "Bash(gh run cancel *)",
      "Bash(gh run delete *)",
      "Bash(gh release *)",
      "Bash(sudo *)"
    ],
    "deny": [
      "Bash(wsl.exe --unregister*)",
      "Bash(wsl.exe * --unregister*)",
      "Bash(wsl --unregister*)",
      "Bash(wsl.exe --import*)",
      "Bash(wsl.exe * --import*)",
      "Bash(wsl.exe --export*)",
      "Bash(wsl.exe * --export*)",
      "Bash(wsl.exe -u root*)",
      "Bash(wsl.exe * -u root*)",
      "Bash(wsl.exe * --user root*)",
      "Bash(schtasks /Delete*)",
      "Bash(schtasks * /Delete*)",
      "Bash(bench update*)",
      "Bash(bench * update*)",
      "Bash(bench restore*)",
      "Bash(bench * restore*)",
      "Bash(mariadb -u root*)",
      "Bash(mariadb -uroot*)",
      "Bash(mariadb --user=root*)",
      "Bash(mariadb * -u root*)",
      "Bash(mariadb * -uroot*)",
      "Bash(mariadb * --user=root*)",
      "Bash(mariadb --user root*)",
      "Bash(mariadb * --user root*)",
      "Bash(mysql -uroot*)",
      "Bash(mysql -u root*)",
      "Bash(mysql --user root*)",
      "Bash(mysql --user=root*)",
      "Bash(mysql * -uroot*)",
      "Bash(mysql * -u root*)",
      "Bash(mysql * --user root*)",
      "Bash(mysql * --user=root*)",
      "Bash(cd /mnt/c*)",
      "Bash(cp * /mnt/c*)",
      "Bash(mv * /mnt/c*)",
      "Bash(rm * /mnt/c*)",
      "Bash(tee /mnt/c*)",
      "Bash(touch /mnt/c*)",
      "Bash(mkdir * /mnt/c*)",
      "Bash(rsync * /mnt/c*)",
      "Bash(ln * /mnt/c*)",
      "Bash(cat ~/.ssh*)",
      "Bash(cp ~/.ssh*)",
      "Bash(cp * ~/.ssh*)",
      "Bash(mv ~/.ssh*)",
      "Bash(rm * ~/.ssh*)",
      "Bash(scp ~/.ssh*)",
      "Bash(head ~/.ssh*)",
      "Bash(tail ~/.ssh*)",
      "Bash(less ~/.ssh*)",
      "Bash(grep * ~/.ssh*)",
      "Bash(sed * ~/.ssh*)",
      "Bash(awk * ~/.ssh*)",
      "Bash(diff * ~/.ssh*)",
      "Bash(python3 * ~/.ssh*)",
      "Bash(find ~/.ssh*)",
      "Bash(find * -delete*)",
      "Bash(*C:\\Users\\*\\.ssh*)",
      "Bash(*C:/Users/*/.ssh*)",
      "Bash(*/c/Users/*/.ssh*)",
      "Read(//mnt/c/**)",
      "Edit(//mnt/c/**)",
      "Write(//mnt/c/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Write(~/.ssh/**)",
      "Read(//c/Users/*/.ssh/**)",
      "Edit(//c/Users/*/.ssh/**)",
      "Write(//c/Users/*/.ssh/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/cloud-context.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/guard-rm.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/guard-writes.sh\""
          }
        ]
      }
    ]
  }
}
