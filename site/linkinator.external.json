{
  "recurse": true,
  "checkFragments": false,
  "retry": true,
  "timeout": 30000,
  "concurrency": 8,
  "skip": [
    "^https?://(localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0|\\[::1\\])",
    "^https?://([a-z0-9-]+\\.)*example\\.(com|org|net|test)",
    "^https?://[^/]*\\.(localhost|local|test)(:|/|$)"
  ],
  "verbosity": "error"
}
