---
// The top bar's links: the changelog (GitHub releases), then the social
// icons Starlight renders by default (GitHub). Plain muted text, as in the
// top nav of akashmishra.com.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<a class="top-link" href="https://github.com/askysh/benchbar/releases">Changelog</a>
<Default />

<style>
  .top-link {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease;
  }
  .top-link:hover {
    color: var(--sl-color-white);
  }
</style>
