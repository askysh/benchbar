{
  "name": "benchbar-docs",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "bun scripts/prepare.mjs",
    "predev": "bun scripts/prepare.mjs",
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview",
