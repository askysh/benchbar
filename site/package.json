    "linkcheck:external": "bun --bun linkinator dist --config linkinator.external.json"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/starlight": "^0.43.1",
    "astro": "^7.4.12",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "linkinator": "^8.1.0"
  }
}
