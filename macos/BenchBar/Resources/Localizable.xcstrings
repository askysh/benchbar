    "Backs the site up with its files, drops its database and moves its folder to archived/sites. Nothing is deleted from disk.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backs the site up with its files, drops its database and moves its folder to archived/sites. Nothing is deleted from disk."
          }
        }
      }
    },
    "Backs the site up, restores it in another bench, checks it there, then drops it here. You see the plan first; nothing runs before you confirm.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backs the site up, restores it in another bench, checks it there, then drops it here. You see the plan first; nothing runs before you confirm."
          }
        }
      }
    },
    "Backs up each site of %@ with its files, drops its database, takes the bench out of benchbar's list and moves the folder to a trash folder next to it. Nothing is deleted.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backs up each site of %@ with its files, drops its database, takes the bench out of benchbar's list and moves the folder to a trash folder next to it. Nothing is deleted."
          }
        }
      }
    },
    "Backs up each site of every expired scratch bench, drops its database and moves the bench folder aside. Nothing is deleted, and the default bench is never touched.": {
      "extractionState": "manual",
