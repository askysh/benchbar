                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg seats"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "comment": "Network: seats of a nearby room. The first number is the people, the second the seats; the noun follows the seats. The singular used to read '1 of 1 seats taken'."
