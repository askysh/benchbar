#!/usr/bin/env bash
#
# benchbar: one entrypoint (also installed as frappe-mac) for a local Frappe/ERPNext bench on macOS.
#
#   benchbar install        phases 00, 01 and the background service, idempotent
#   benchbar up | down      start or stop the bench in the background
#   benchbar doctor         read-only health report with exact fix commands
#   benchbar repair         apply only the fixes doctor flagged
#
# Runs on macOS /bin/bash 3.2. No dependencies beyond the ones the installer
# already needs.

set -euo pipefail

FL_VERSION="0.7.3"

# Resolve the real script location even when invoked through a symlink
# (for example ~/.local/bin/frappe-mac).
# dirname by parameter expansion: every status poll of the app starts here
fl_resolve_self_dir() { case "$1" in */*) printf '%s' "${1%/*}" ;; *) printf '.' ;; esac; }
fl_resolve_self_once() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir="$(cd "$(fl_resolve_self_dir "$src")/" 2>/dev/null && pwd)" || return 1
    src="$(readlink "$src" 2>/dev/null)" || return 1
    [[ "$src" == /* ]] || src="${dir}/${src}"
  done
  dir="$(cd "$(fl_resolve_self_dir "$src")/" 2>/dev/null && pwd)" || return 1
  # the folder of this CLI's files, not one a link passed through
  [[ -f "${dir}/lib/frappe-local/install-kind.sh" ]] || return 1
  printf '%s' "$dir"
}
fl_resolve_self() {
  local i=0
  # the app's link in ~/.local/state/benchbar/bin is away for a moment while
  # the first run after an upgrade moves the state folder into place
  # (state.sh): a start in that moment tries again, up to 2 s. A normal
  # start resolves at the first try and starts no process for it.
  until fl_resolve_self_once; do
    if [[ "$i" -ge 20 ]]; then cd "$(fl_resolve_self_dir "${BASH_SOURCE[0]}")/" && pwd; return; fi
    sleep 0.1; i=$((i + 1))
  done
}
