#!/usr/bin/env bash
#
# benchbar: one entrypoint (also installed as frappe-mac) for a local Frappe/ERPNext bench on macOS.
#
#   benchbar install        phases 00, 01 and the background service, idempotent
#   benchbar up | down      start or stop the bench in the background
#   benchbar doctor         read-only health report with exact fix commands
#   benchbar repair         apply only the fixes doctor flagged
#
# Runs on macOS /bin/bash 3.2. No dependencies beyond the ones the installer
# already needs.

set -euo pipefail

FL_VERSION="0.7.2"

# Resolve the real script location even when invoked through a symlink
# (for example ~/.local/bin/frappe-mac).
# dirname by parameter expansion: every status poll of the app starts here
fl_resolve_self_dir() { case "$1" in */*) printf '%s' "${1%/*}" ;; *) printf '.' ;; esac; }
fl_resolve_self() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir="$(cd "$(fl_resolve_self_dir "$src")/" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" == /* ]] || src="${dir}/${src}"
  done
  cd "$(fl_resolve_self_dir "$src")/" && pwd
}
SCRIPT_DIR="$(fl_resolve_self)"
