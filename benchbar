usage() {
  cat <<USAGE | fl_lab_usage_filter
benchbar ${FL_VERSION}: local Frappe/ERPNext bench on macOS and Linux, in the background.

Usage: benchbar <command> [options]

Setup
  install             Run phase 00 (system deps), 01 (bench and site) and the
                      background service. Safe to re-run: only changes what changed.
                      --json (with --yes or --dry-run): JSON lines for the BenchBar app.
                      --frappe-commit SHA, --erpnext-commit SHA: pin the clones (or frappe_commit
                      and erpnext_commit in a team profile); a commit the clone does not reach
                      stops the install before anything is built.
  adopt PATH         Register an existing bench: Procfile.lean, runner, agent, helpers.
                      Shows the plan and asks; never runs migrate, build or update.
                      --json (with --yes or --dry-run): JSON lines, as install.
  service             Install or refresh only the background service (phase 02).
  doctor              Read-only health report. Exit 1 when something FAILs.
                      --fix-hints: only the fix commands of FAIL and WARN checks, one per line.
                      --prerequisites: what this Mac needs before an install, no bench needed
                      (--json; --bench-dir names the folder a new bench would go to).
                      --fetch: git fetch the branches of the apps your focus apps need first
                      (without it doctor never touches the network).
                      --ack CHECK / --unack CHECK: silence one warning until its message
                      changes, or undo that. --quick: skip the slow checks and say which.
  ports setup -- PATH ...
                      Preview management/port changes, confirm once, then apply (--dry-run: preview only)
  ports plan -- PATH ...
                      Show the same read-only preview (--json: machine-readable plan and token)
  ports check         Check conflicts for --bench-dir PATH (--json)
  ports mode automatic|fixed
                      Keep automatic or fixed ports for --bench-dir PATH
  ports apply TOKEN --yes -- PATH ...
                      Apply a previously reviewed JSON plan; refuse stale approvals
  report              Redacted diagnostics zip on the Desktop for bug reports (--print: to the terminal,
                      --json: {"zip": path, "redactions": n} for the app and scripts).
  repair              Apply only the fixes doctor flagged, in dependency order.
  uninstall-service   Remove the agent, runner, Procfile.lean and shell helpers.
                      --all: every bench with a benchbar agent, after one question (before
                      brew uninstall benchbar: brew cannot stop the agents itself).
  self-update         Update the benchbar CLI and the BenchBar app with the one line installer,
                      after asking (--check: this version against the latest, --json, --dry-run).
                      A Homebrew install runs brew upgrade askysh/tap/benchbar instead.
                      Never touches a bench; never runs bench update.
  where               How this CLI was installed (homebrew, managed, checkout, other), the path
                      it records for itself, its state folder and the BenchBar app (--json).

Daily
  up                  Start the bench in the background (benchup).
                      --services-only: only its Redis, for a restore or a migrate (down stops it).
  down                Stop it and keep it stopped across reboots (benchdown).
  restart             Restart it, for example after changing Python code.
  status              State, pid, stop reason, site ping, Redis (benchstatus). --json adds
                      redis and sites[].served (does the running bench serve the site).
  stats               CPU and memory of the running bench's own processes, and the figure the
                      app's runner speed comes from (--json; resources is null when stopped).
  wait                Block until the bench is ready (site answers, socketio, Redis, a worker, code
                      not changed since the start); --for PART for one part, --timeout SECS, --json.
  list                Every bench benchbar knows about.
  scan PATH           Find benches recursively in a folder (read only; --json).
  register PATH ...   Remember selected benches without changing their services.
  logs                Tail logs/bench.log. Flags: --worker, --worker-error, --previous, -n50, --no-follow,
                      --process web|socketio|schedule|worker (worker reads logs/worker.log; with --json:
                      the lines as JSON, --since TIME or --since-restart for the newer ones only)
  fg                  Stop the service and run honcho in the foreground.
  watch               Run bench watch for asset rebuilds.
  autostart on|off    Whether the bench may come back after login.
  listen local|all    Where the web server and socketio listen: 127.0.0.1 (default) or every interface.
  path                Print the bench directory (used by benchcd).
  site list           The bench's sites; the default one is what benchup waits for.
  site add NAME       bench new-site (MariaDB password from the Keychain, a file on Linux), the hosts line, and
                      --bundle NAME or --apps "a b" from apps/. The default stays.
  site default NAME   Make NAME the default site (bench use, runner, benchup, the app).
  site hosts          Add a 127.0.0.1 line for every site to /etc/hosts (sudo, once).
  site backup NAME    bench --site NAME backup (--with-files for the uploads too; --json).
  site backups NAME   The site's backups, newest first: time, size, with files (--json).
  site snapshot NAME [--label TEXT]
                      Save the state of a site (database, files, site_config) in a folder frappe's
                      backup pruning never touches.
  site snapshots NAME The snapshots, newest first, and whether the bench's apps still match.
  site rollback NAME --to SNAPSHOT
                      Put a snapshot back (a reviewed plan; the current state is snapshotted first).
  site move NAME --to-bench PATH
                      Move a site to another registered bench (a reviewed plan: backup, restore
                      there, migrate, check, then the drop here; the backups stay).
  site restore NAME   Restore a backup set (--from STAMP or the database file's PATH, --from-site S)
                      into a site: it is backed up first, or --new creates it. --no-migrate,
                      --before-migrate SCRIPT, --with-files. --neutralise switches the restored
                      site's integrations off and clears its stored secrets (for a set that is
                      not this bench's own; an agent must pass it). --dry-run --json prints the plan with
                      its token; --apply TOKEN --yes [--json] runs exactly that plan.
  site drop NAME      bench drop-site: a backup with files first, the folder moved to
                      archived/sites, the hosts line removed. Needs --confirm-site NAME;
                      the default site also needs --new-default OTHER (--dry-run, --json).
  console             bench --site SITE console: a Python shell with frappe (--site S).
  db                  bench --site SITE mariadb: the site's database with its own user (--site S).
  open                Open the site in the browser (--site S, --path /app/...). --as USER signs in
                      as that user, no password; needs developer_mode and a person to run
                      "site open-as on" for the site. --print-url prints the link instead.
  users               Enabled users of a site for open --as (--site S, --search TEXT, --limit N).
  share setup         Make a hardened copy of a site (share.localhost) and the host identity for
                      sharing it on your network. Needs a person at a terminal and --acknowledge-data:
                      the copy holds the site's real data, and the MariaDB root password (Keychain,
                      MARIADB_ROOT_PASSWORD or typed). --users A,B, --name LABEL, --from STAMP|latest,
                      --backup-now, --refresh, --regenerate-identity, --dry-run, --json.
  share users         Who can take a seat in a shared copy, and which roles each would lose there.
  share preflight     The checks that say whether this Mac is safe to share the copy: the pf block
                      probed from the LAN address, the share web process, the firewall, the copy and
                      its seats. --static or --critical for half, --quiet, --json; exit 1 on a fail.
  share join [ADDR]   Join somebody's room as a guest: with ADDR (the host's IPv4 address) it asks
                      for the room code, without one for the invite link. Neither is ever an
                      argument. It shows the host key first, waits for a seat, and opens the room on
                      a localhost address. share joined lists the rooms, share leave gives the seat
                      back, share forget also deletes this computer's key for that host.
  lan-guard install   The pf anchor (macOS) or nftables table (Linux) that keeps the bench ports off
                      the LAN, and the daemon or systemd unit that loads it at boot (sudo, once; a
                      person at a terminal). status (--json), remove, and allow-node (macOS only:
                      lets the share gateway's node through the macOS firewall).
  mariadb-password    Print the MariaDB root password (Keychain; a 0600 file on Linux; asks first).
                      A person's command: refused for agents, mcp and without a terminal.
  mcp                 Model Context Protocol server on stdio for coding agents
                      (claude mcp add benchbar -- benchbar mcp). Read tools, up, down, restart,
                      changes from a reviewed plan. --calls [N] prints the audit log.
  op status [OP_ID]   The long runs. Every command that changes things has an op_id (in its JSON
                      lines too); status shows one (or the ten newest) with its step and last
                      progress, list shows the recent ones, wait OP_ID [--timeout SECS] waits for
                      one to end. A run that died without a done line is interrupted.
  history             What ran on this machine, newest first: the command line (secrets as ***), who
                      started it (a terminal, the app, the tray, an agent through MCP, a script), the
                      bench, the times, the exit and what it changed. --bench PATH, --since 7d,
                      --limit N, --json.
  docs [TOPIC]        Open the documentation, or one topic's page (benchbar docs --help lists
                      them: install, doctor, apps, mcp, json ...); --print prints the URL.

Apps
  app list            Every app: branch, commit, local changes, the sites that have it
                      (--json; --no-sites reads the last site lists instead of asking bench).
  app add NAME|URL    bench get-app from config/apps.tsv or any git URL (GitHub, SSH, a
                      host alias), after checking access; --branch B, --name N, --commit SHA
                      (pin the clone to a commit), and --site S or --all-sites to install it.
                      Several apps in one plan: app add A --commit SHA B --install-on s1,s2
                      (--branch, --name, --commit and --install-on belong to the app before
                      them). Never replaces an app.
                      --dry-run --json: the plan with its token (required apps read from
                      hooks.py); --apply TOKEN --yes runs exactly that plan, no questions.
  app install NAME    Install an app of the bench on a site (--site S). --dry-run --json: the
                      plan with its token; --apply TOKEN --yes runs exactly that plan.
  app update NAME     Fast forward one app with a changelog first, back up the sites
                      that have it, then requirements, migrate and build (--skip-backup).
                      A run that stopped half way is finished by the next one (only the steps
                      left); --discard-pending drops that record and stops (nothing runs).
                      --dry-run --json: the plan with its token; --apply TOKEN --yes runs it.
  app focus [NAME]    Focus apps (the ones you work on: local changes, another branch, a
                      commit of yours in 14 days): doctor warns when an app they need falls
                      behind. No NAME lists them (--list, --json, --fetch); NAME pins it as
                      focus, --auto infers again.
  app unfocus NAME    Pin NAME as not a focus app.

Team lockfile (benchbar.toml: each app's repo, branch and commit, and the sites)
  lock write          Write it from this bench (asks, shows the diff, backs up the old one);
                      --lock PATH (remembered), --no-commits, --allow-dirty.
  lock check          Compare the bench with it: read only, no network, no database.
                      Exit 1 on any difference (--json).
  lock apply          Clone missing apps, switch branches, fast forward to pinned commits,
                      then requirements and build. Never touches a site or local work.
                      --dry-run --json: the plan with its token; --apply TOKEN --yes runs it.

Team profiles
  profile list        Built in and team profiles, with where each comes from (--json).
  profile show NAME   What a profile installs: base, Python, Node, MariaDB, apps.
  profile create NAME --from-bench PATH [--dir DIR]
                      Write a team profile from a bench (read only: app repos and
                      branches, the base from its frappe version). install --profile NAME
                      then builds the same bench on another Mac.
  profile export NAME [--out FILE] [--branch APP=BR]... [--drop APP]... [--plan]
                      A copy to share: SSH aliases resolved, each repo's default branch,
                      access (public, private, personal) and requires per app.
  profile import FILE|URL [--as NAME] [--plan]
                      Add a profile someone sent (https only, 64 KB at most); checks
                      which repos you can read. A GitHub page URL is fetched raw.
  profile subscribe GIT_URL [--plan]
                      Clone a team's config repo; its profiles join the lookup path.
  profile update NAME|--all [--plan]
                      Fetch an import or subscription again, show the diff, ask.
  profile remove NAME Move an import or a whole subscription aside.
  profile check NAME  Can git read every repo with your credentials? (--json)

Experiments (off until a person turns one on)
  labs [list]         The experiments and whether each is on (--json).
  labs on NAME        Turn one on, in a terminal, after its warning. Never from an agent.
  labs off NAME       Turn one off and undo what it started. labs status NAME: exit 1 when off.

Leases (a bench or a site held for a while, so nothing restarts, migrates, drops or restores it meanwhile)
  lease take          --bench PATH or --site NAME, --for MINUTES (default 30, at most 480), --note TEXT;
                      prints the lease id (--json). Set BENCHBAR_CALLER to a name for the holder;
                      an agent run without one cannot take a lease.
  lease renew ID      Push the end back (--for MINUTES).   lease release ID  Let go of it.
  lease list          The active leases (--bench PATH, --json). A lease id is shown to its holder
                      only. Pass --lease ID to a command that changes
                      what a lease covers; --break-lease is for a person at a terminal only.

Defaults that changed
  notices             The notices an update left (a new default and its way back), --json.
                      --dismiss ID or --all hides them (also in the BenchBar app).

Production copy
  pull HOST:SITE      Copy a production site over SSH into a NEW local site: the latest
                      backup on the server (nothing written there), the encryption key,
                      email muted, the scheduler paused and the copy neutralised
                      (integrations off, stored secrets cleared). HOST is from ~/.ssh/config.
    --as NAME         Local site name (default: SITE.local)
    --from-dir DIR    A backup set downloaded by hand (Frappe Cloud), no SSH
    --remote-bench D  The bench folder on the server (default ~/frappe-bench)
    --new-backup      Run bench backup on the server first (it also deletes older
                      backups there); asks for the site name, or --confirm-site SITE
    --replace         Restore over an existing local site, after backing it up
    --skip-app APP    Restore without APP (its tables stay behind as orphans)
    --no-files        Database only; --keep-scheduler, --keep-staging
    --keep-secrets    Leave the copy as production had it. By default it is neutralised:
                      outbound integrations off, stored secrets cleared, tokens and
                      queued mail dropped (the Administrator login is kept).
                      A person's decision: refused for agents and benchbar mcp
    --no-migrate      Stop after the restore, before bench migrate
    --before-migrate S  Run the executable SCRIPT after the restore, before migrate (with
                      BENCHBAR_SITE, BENCHBAR_BENCH, BENCHBAR_DB_NAME; no secret in its
                      environment); a failing script stops the run
                      The local site is created when it does not exist.

Options
  --bench-dir DIR     Bench to act on (default: remembered, or auto-detected)
  --site NAME         Site name (default: remembered, or from the bench)
  --profile NAME      Release profile for install/repair (default: v15-lts), or a team
                      profile (~/.config/benchbar/profiles/NAME.toml, BENCHBAR_PROFILE_PATH)
  --bundle NAME       App bundle for install (minimal, common, extended)
  --scratch, --ttl DAYS
                      install: the bench expires after DAYS (default 7); benchbar bench gc removes it
  --make-default      install, adopt, service: make this the default bench even when
                      another one is already the default
  --repair-bench      install: move a bench folder that is incomplete aside and start over (never
                      one that holds a site; --dry-run shows the move)
  --allow-windows-fs  install, adopt (WSL): accept a bench on the Windows file system
                      (/mnt/c, drvfs, 9p), which is slow and breaks file watching
  --allow-unsupported-distro
                      install (Linux): try a system other than Ubuntu 24.04, which is the one
                      the install is tested on and supports (at your own risk)
  --with-schedule     service: add the scheduler to Procfile.lean (per bench, kept by repair)
  --without-schedule  service: remove it again (the default)
  --port-offset N     install, adopt, service: use port block N (web 8000+N, socketio 9000+N,
                      redis 11000+N and 13000+N). Default: keep the ports, or the next
                      free block when another bench already uses them
  --dry-run           Print the full plan, change nothing
  --offline           install: skip the remote branch checks (also OFFLINE=1 or BENCHBAR_OFFLINE=1)
  -y, --yes           Do not ask; secrets must come from the environment
  --json              Versioned JSON for list, status and doctor; JSON lines for pull,
                      install, adopt, repair, up, down, restart, service, site add,
                      app update and ports apply (docs/json-schema.md)
  --lease ID          A lease you hold (benchbar lease take): the command may change what it covers
  --break-lease       A person at a terminal goes ahead although a lease covers the command
  --jsonl             JSON lines (plan, step, done) from any command that changes things
  --for-agent         --jsonl or --json, no questions (BENCHBAR_NONINTERACTIVE=1), no colors
  --background        install, repair, pull, app add, app update, site add, site backup, site restore,
                      site snapshot, site rollback:
                      start the run detached and print its op_id at once (needs --yes; no questions)
  benchbar COMMAND --help prints that command's flags and needs; benchbar commands --json lists them all
  --plain             No colors or spinners (also: NO_COLOR=1, or a non-TTY)
  -h, --help          This help
  --version           Print the version (and the BenchBar app's, when it is installed)

Environment:
  BENCHBAR_SUDO=gui   root steps (wkhtmltopdf, /etc/hosts) ask in a macOS password dialog, not sudo
  BENCHBAR_SUDO=env   Linux: sudo steps use the password in BENCHBAR_SUDO_PASSWORD, no terminal needed
  BENCHBAR_CALLER     Who started the run, for benchbar history: terminal, app, tray, mcp, agent or
                      script (set by the app, the tray and benchbar mcp; --for-agent says agent)
  BENCH_INIT_TIMEOUT_SECONDS   install: how long bench init may run (default 2700, 0 for no limit)
  BENCHBAR_LENIENT_FLAGS=1     an unknown option is a warning, not an error (exit 64), as before 0.9.0

Shell helpers (written to your shell rc by install or repair):
  benchup benchdown benchrestart benchstatus benchlogs benchfg benchwatch benchdoctor benchcd

Documentation: $(fl_docs_url /)
USAGE
}

# benchbar --version: the first line stays "benchbar X.Y.Z" (the app and
# scripts read it); the installed app's version follows on its own line, and
# after a hand off the copy that was started and its version: the version
# above is then the app's CLI's, not the one of the benchbar the person ran.
fl_print_version() {
  local app tab=$'\t' via=""
  printf 'benchbar %s\n' "$FL_VERSION"
  app="$(fl_app_bundle_info)"
  [[ -z "$app" ]] || printf 'BenchBar app %s (%s)\n' "${app%%"$tab"*}" "${app#*"$tab"}"
  [[ -n "$FL_HANDOFF_FROM" ]] || return 0
  fl_handoff_via_v via
  printf 'via %s%s, which hands off to the CLI inside BenchBar.app\n' "$FL_HANDOFF_FROM" "${via:+ (${via})}"
  fl_handoff_newer_hint "$via"
}

# fl_opt_value FLAG ARGC VALUE: a flag that takes a value has one, and the value is not the next
# option (benchbar where --bench-dir --json took --json for the folder). Exit 64, error_id
# missing_value, like any usage error (fl_usage_refuse; BENCHBAR_LENIENT_FLAGS does not cover it).
# Callers are plain statements of the main loop, and fl_usage_refuse ends in exit: it never relies
# on set -e, which bash switches off inside a function that an `if` or `||` calls.
fl_opt_value() {
  local key="" usage=""
  [[ "$2" -ge 2 && "$3" != -* ]] && return 0
  if [[ -n "$COMMAND" ]]; then key="$(fl_cmd_key_for "$COMMAND" "${ARGS[0]:-}")" || key=""; fi
  [[ -z "$key" ]] || fl_cmd_usage_v usage "$key"
  fl_usage_refuse missing_value "$1 needs a value." "${usage:+Usage: ${usage}. }Example: benchbar ${key:-COMMAND} $1 VALUE (or $1=VALUE). Every flag: benchbar ${key:-COMMAND} --help" "$key"
}

# the command line as it came: a usage error (fl_usage_refuse) reads --json and --for-agent from
# it, because the loop below may not have reached them yet
FL_ORIG_ARGS=("$@")
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --bench-dir) fl_opt_value "$1" "$#" "${2-}"; OPT_BENCH_DIR="$2"; shift 2 ;;
    --bench-dir=*) OPT_BENCH_DIR="${1#*=}"; shift ;;
    --site) fl_opt_value "$1" "$#" "${2-}"; OPT_SITE="$2"; shift 2 ;;
    --site=*) OPT_SITE="${1#*=}"; shift ;;
    --profile) fl_opt_value "$1" "$#" "${2-}"; OPT_PROFILE="$2"; shift 2 ;;
    --profile=*) OPT_PROFILE="${1#*=}"; shift ;;
    --bundle) fl_opt_value "$1" "$#" "${2-}"; OPT_BUNDLE="$2"; shift 2 ;;
    --bundle=*) OPT_BUNDLE="${1#*=}"; shift ;;
    --dry-run) FL_DRY_RUN=1; shift ;;
    --offline) OFFLINE=1; shift ;;
    --make-default) FL_MAKE_DEFAULT=1; shift ;;
    --repair-bench) OPT_REPAIR_BENCH=1; shift ;;
    --allow-windows-fs) FL_ALLOW_WINDOWS_FS=1; shift ;;
    --allow-unsupported-distro) FL_ALLOW_UNSUPPORTED_DISTRO=1; export BENCHBAR_ALLOW_UNSUPPORTED_DISTRO=1; shift ;;
    --with-schedule) FL_SCHEDULER=on; shift ;;
    --without-schedule) FL_SCHEDULER=off; shift ;;
    --port-offset) fl_opt_value "$1" "$#" "${2-}"; OPT_PORT_OFFSET="$2"; shift 2 ;;
    --port-offset=*) OPT_PORT_OFFSET="${1#*=}"; shift ;;
    -y|--yes) FL_ASSUME_YES=1; shift ;;
    --json) OPT_JSON=1; shift ;;
    --jsonl) OPT_JSON=1; OPT_JSONL=1; shift ;;
    --for-agent) OPT_FOR_AGENT=1; shift ;;
    --lease) [[ -n "${2:-}" && "${2:-}" != -* ]] || fl_die "--lease needs a lease id." "benchbar lease take returns one"; OPT_LEASES="${OPT_LEASES} $2"; shift 2 ;;
    --lease=*) OPT_LEASES="${OPT_LEASES} ${1#*=}"; shift ;;
    --break-lease) OPT_BREAK_LEASE=1; shift ;;
    --background) OPT_BACKGROUND=1; shift ;;
    --ack) fl_opt_value "$1" "$#" "${2-}"; OPT_ACK="$2"; shift 2 ;;
    --ack=*) OPT_ACK="${1#*=}"; shift ;;
    --unack) fl_opt_value "$1" "$#" "${2-}"; OPT_UNACK="$2"; shift 2 ;;
    --unack=*) OPT_UNACK="${1#*=}"; shift ;;
    --quick) OPT_QUICK=1; shift ;;
    --fix-hints) OPT_FIX_HINTS=1; shift ;;
    --prerequisites) OPT_PREREQ=1; shift ;;
    --ping) OPT_PING=1; shift ;;
    --deep) OPT_DEEP=1; shift ;;
    --fetch) FL_FETCH=1; shift ;;
    --frappe-commit) [[ -n "${2:-}" && "${2:-}" != -* ]] || fl_die "--frappe-commit needs a commit hash." "Example: benchbar install --frappe-commit 0123abc"; OPT_FRAPPE_COMMIT="$2"; shift 2 ;;
    --frappe-commit=*) OPT_FRAPPE_COMMIT="${1#*=}"; shift ;;
    --erpnext-commit) [[ -n "${2:-}" && "${2:-}" != -* ]] || fl_die "--erpnext-commit needs a commit hash." "Example: benchbar install --erpnext-commit 0123abc"; OPT_ERPNEXT_COMMIT="$2"; shift 2 ;;
    --erpnext-commit=*) OPT_ERPNEXT_COMMIT="${1#*=}"; shift ;;
    --scratch) OPT_SCRATCH=1; shift ;;
    --ttl) OPT_TTL="${2:-}"; shift 2 || shift ;;
    --ttl=*) OPT_TTL="${1#*=}"; shift ;;
    --plain|--no-color) FL_PLAIN=1; fl_ui_init; shift ;;
    --version) fl_print_version; exit 0 ;;
    # benchbar docs --help lists the topics; a command's --help is its entry in
    # commands.sh (after the loop: the subcommand may come later), else this one
    -h|--help) if [[ "$COMMAND" == "docs" || "$COMMAND" == "self-update" ]]; then ARGS+=("$1"); shift; else FL_WANT_HELP=1; shift; fi ;;
    # run keeps where "--" was: the words before it are benchbar's, the ones after it the bench command's
    --) shift; FL_ARGS_FLAGS_N="${#ARGS[@]}"; [[ "$COMMAND" != "run" ]] || FL_RUN_SEP="${#ARGS[@]}"; ARGS+=("$@"); break ;;
    -*)
      if [[ -n "$COMMAND" ]]; then ARGS+=("$1"); shift; else fl_usage_refuse unknown_flag "Unknown option: $1" "Run: benchbar --help"; fi ;;
    *)
      if [[ -z "$COMMAND" ]]; then COMMAND="$1"; else ARGS+=("$1"); fi
      shift ;;
  esac
done
export FL_DRY_RUN
# nothing can be asked of a run nobody watches: the questions are refused up front, as for an agent
if [[ "$OPT_BACKGROUND" == "1" ]]; then BENCHBAR_NONINTERACTIVE=1; export BENCHBAR_NONINTERACTIVE; fi
# the options after the command are the command's own: each is in its entry of commands.sh,
# else the run stops (exit 64) before anything is taken, started or written
[[ "$FL_WANT_HELP" == "1" || -z "$COMMAND" ]] || fl_args_validate
# --secrets-stdin: the passwords come on standard input (secrets.sh), before anything else reads it
[[ "$FL_LEAN" == "1" ]] || fl_secrets_stdin_take
# the passwords stay shell variables of this process: the phase scripts get
# them on their own command line below, no other child (brew, pip, npm,
# yarn, bench get-app) sees them
export -n MARIADB_ROOT_PASSWORD ADMIN_PASSWORD

if [[ "$FL_WANT_HELP" == "1" ]]; then
  # a command of a lab that is off shows the refusal, not its help (but for the ones that undo the lab)
  [[ -z "$COMMAND" ]] || fl_lab_gate "$(fl_cmd_key_for "$COMMAND" "${ARGS[0]:-}" || printf '%s' "$COMMAND")"
  if [[ -n "$COMMAND" ]] && FL_HELP_KEY="$(fl_cmd_key_for "$COMMAND" "${ARGS[0]:-}")"; then fl_cmd_help "$FL_HELP_KEY"; else usage; fi
  exit 0
fi

[[ -n "$COMMAND" ]] || { usage; exit 0; }
# root owns files the user then cannot write (the state folder, logs, the bench lock): benchbar asks for sudo
# itself, for the few steps that need it. `doctor --prerequisites` only reads and reports, and its
# regular_user check is how a person learns that they ran it as root, so it is not refused.
if [[ "$COMMAND" != "help" ]] && ! [[ "$COMMAND" == "doctor" && "${OPT_PREREQ:-0}" == "1" ]]; then
  fl_refuse_root
fi

# status, list and the other readers are polled: they skip the table unless
# --for-agent asks for it
case "$COMMAND" in
  install|adopt|repair|pull|up|down|restart|wait|service|site|app|ports|share|lan-guard|labs|register|autostart|listen|uninstall-service|profile|lock|self-update|run|bench|db|lease) fl_json_mode_resolve ;;
  *) if [[ "$OPT_FOR_AGENT" == "1" || "$OPT_JSONL" == "1" ]]; then fl_json_mode_resolve; fi ;;
esac
# --jsonl and --for-agent: a command that only reads ends with one document that has `exit`
# (a read that has the share family's fields already is only kept back to catch a failure)
FL_READ_KIND=""; FL_READ_MUT=""
if [[ "$OPT_JSON" == "1" && ( "$OPT_JSONL" == "1" || "$OPT_FOR_AGENT" == "1" ) && ( -z "$FL_JSON_MODE" || ( "$FL_JSON_MODE" == "doc" && "$OPT_JSONL" != "1" ) ) && -n "$FL_JSON_KEY" ]]; then
  fl_cmd_attr_v FL_READ_KIND "$FL_JSON_KEY" json
  fl_cmd_attr_v FL_READ_MUT "$FL_JSON_KEY" mutating
  if [[ "$FL_READ_KIND" == "document" && "$FL_READ_MUT" == "no" ]]; then fl_read_env_begin; fi
fi

# fl_app_focus_is_listing ARGS...: "app focus" with no app name lists the
# focus apps (a read), with any of --list, --json, --fetch
fl_app_focus_is_listing() {
  local a
  [[ "$COMMAND" == "app" && "${1:-}" == "focus" ]] || return 1
  shift
  for a in "$@"; do
    case "$a" in -*) ;; *) return 1 ;; esac
  done
  return 0
}

fl_mode_name() {
  if [[ "$FL_DRY_RUN" == "1" ]]; then printf 'dry-run'; else printf '%s' "$COMMAND"; fi
}

fl_cleanup() {
  local code=$?
  # the ERR trap keeps out of the exit trap: set -e alone ends a cleanup that fails
  FL_EXITING=1
  fl_spinner_stop
  # pull closes its SSH connection and ends its JSON stream with "done"
  fl_pull_on_exit "$code"
  # share setup never leaves the scheduler of every site paused, whatever stopped it
  fl_share_on_exit
  # a run cut short between the start and the end of bench's backup puts the kept older backups back
  fl_backups_keep_on_exit
  # a setup Redis started for site add goes, however the command ends
  fl_bench_redis_down >/dev/null 2>&1 || true
  # share preflight's throwaway listener, when a signal ended the run while it was up
  fl_sp_listener_stop
  fl_sudo_end
  fl_lock_release
  # the first run of a fresh install records its version, whatever its exit code (notices.sh)
  fl_notices_on_exit "$code"
  # a doctor run that was cut short leaves its folder of kept answers (facts.sh)
  fl_facts_end
  # the temp logs of a long command, when a signal ended the run
  fl_tmp_cleanup
  # install --json and adopt --json: always the last line, after the lock is free
  fl_jsonl_on_exit "$code"
  # the operation's record is finished once its done line is out, so a reader that sees the run end
  # finds the done line in its output (ops.sh)
  fl_op_end "$code"
  # repair --json: its done line, when the run ended before it could send one
  fl_repair_done "$code"
  # --jsonl and --for-agent on a command that reads: its document, with exit
  fl_read_env_finish "$code"
  [[ -z "${FL_CHANGED_FILE:-}" || "${FL_CHANGED_OWNER:-}" != "$$" ]] || rm -f "$FL_CHANGED_FILE"
}
trap fl_cleanup EXIT
trap 'fl_on_error "$BASH_COMMAND"' ERR
# TERM, INT and HUP reach the running command's whole process group and the
# phase script in the foreground, then the EXIT trap releases the lock
fl_signal_traps_install

# The JSON stream: lib/frappe-local/stream.sh (CORE-18). It is sourced here, where its code used to be,
# and by a lean start too: the exit trap sends the done line.
# shellcheck source=lib/frappe-local/stream.sh
. "${SCRIPT_DIR}/lib/frappe-local/stream.sh"

# The bodies of the commands: lib/frappe-local/cmd-<command>.sh (CORE-18, maintainers/DECISIONS.md). They
# are sourced here, where the functions used to be, so a run that ends before this point (--version,
# --help, a usage error) does not read them. A lean start skips them: no lean command calls one.
# shellcheck source=lib/frappe-local/cmd-doctor.sh
[[ "$FL_LEAN" == "1" ]] || . "${SCRIPT_DIR}/lib/frappe-local/cmd-doctor.sh"
# shellcheck source=lib/frappe-local/cmd-repair.sh
[[ "$FL_LEAN" == "1" ]] || . "${SCRIPT_DIR}/lib/frappe-local/cmd-repair.sh"
# shellcheck source=lib/frappe-local/cmd-service.sh
[[ "$FL_LEAN" == "1" ]] || . "${SCRIPT_DIR}/lib/frappe-local/cmd-service.sh"
# shellcheck source=lib/frappe-local/cmd-adopt.sh
[[ "$FL_LEAN" == "1" ]] || . "${SCRIPT_DIR}/lib/frappe-local/cmd-adopt.sh"
# shellcheck source=lib/frappe-local/cmd-install.sh
[[ "$FL_LEAN" == "1" ]] || . "${SCRIPT_DIR}/lib/frappe-local/cmd-install.sh"

# benchbar where [--json]: how this CLI was installed and where its things
# are. Read only: no bench, no lock, no log.
cmd_where() {
  local info app_version="" app_path="" tab=$'\t' how via_version="" state_real
  [[ "${#ARGS[@]}" == "0" ]] || fl_die "Unexpected argument for where: ${ARGS[0]}" "Usage: benchbar where [--json]"
  if [[ "$FL_INSTALL_KIND" == app ]]; then
    # the app this CLI is part of, not the first one found
    app_path="${SCRIPT_DIR%/Contents/Resources/cli}"; app_version="$(fl_app_bundle_version_at "$app_path")"
  else
    info="$(fl_app_bundle_info)"
    if [[ -n "$info" ]]; then app_version="${info%%"$tab"*}"; app_path="${info#*"$tab"}"; fi
  fi
  # the version of the copy that handed off: an older app's CLI runs in its place
  fl_handoff_via_v via_version
  # the folder behind the state path: the same, unless ~/.local/state/benchbar
  # is a link to the installer checkout's folder on another volume (state.sh)
  state_real="$FL_STATE_DIR"
  if [[ -d "$FL_STATE_DIR" ]]; then state_real="$(cd "$FL_STATE_DIR" 2>/dev/null && pwd -P)" || state_real="$FL_STATE_DIR"; fi
  if [[ "$OPT_JSON" == "1" ]]; then
    printf '{"schema_version":%d,"cli_version":%s,"install":%s,"self":%s,"state_dir":%s,"state_dir_real":%s,"app_version":%s,"app_path":%s,"handoff_from":%s,"handoff_from_version":%s}\n' \
      "$FL_SCHEMA_VERSION" "$(fl_json_str "$FL_VERSION")" "$(fl_json_str "$FL_INSTALL_KIND")" "$(fl_json_str "$FL_SELF")" \
      "$(fl_json_str "$FL_STATE_DIR")" "$(fl_json_str "$state_real")" "$(fl_su_json_or_null "$app_version")" "$(fl_su_json_or_null "$app_path")" \
      "$(fl_su_json_or_null "$FL_HANDOFF_FROM")" "$(fl_su_json_or_null "$via_version")"
    return 0
  fi
  case "$FL_INSTALL_KIND" in
    homebrew) how="with Homebrew (brew upgrade askysh/tap/benchbar)" ;;
    managed) how="with the one line installer (benchbar self-update)" ;;
    app) how="inside BenchBar.app (it updates with the app: Sparkle or brew upgrade)" ;;
    checkout) how="as a git checkout (git pull)" ;;
    *) how="some other way" ;;
  esac
  printf 'benchbar %s, installed %s\n' "$FL_VERSION" "$how"
  printf '  install  %s\n' "$FL_INSTALL_KIND"
  printf '  self     %s\n' "$FL_SELF"
  [[ -z "$FL_HANDOFF_FROM" ]] || printf '  via      %s%s, which hands off to this CLI\n' "$FL_HANDOFF_FROM" "${via_version:+ (${via_version})}"
  [[ -z "$(fl_handoff_newer_hint "$via_version")" ]] || printf '           %s\n' "$(fl_handoff_newer_hint "$via_version")"
  if [[ "$state_real" != "$FL_STATE_DIR" ]]; then printf '  state    %s -> %s\n' "$FL_STATE_DIR" "$state_real"; else printf '  state    %s\n' "$FL_STATE_DIR"; fi
  if [[ -n "$app_path" ]]; then printf '  app      %s (%s)\n' "$app_path" "$app_version"; else printf '  app      not installed\n'; fi
}

# cmd_mcp: the MCP server, on a Python 3.9+ that imports only the standard
# library. A python3 from PATH of 3.10 or newer comes first (3.9, the Command
# Line Tools' version, is past its end of life), then Apple's /usr/bin/python3
# when the Command Line Tools are installed (xcode-select -p; without them it
# is a stub that only offers to install them), then any python3 from PATH of
# 3.9. A GUI client (Claude Desktop) may start us with a PATH that leads to a
# pyenv shim or a project venv: each candidate is run and checked, and -I
# (isolated mode) ignores PYTHON* variables, the user site and the script
# folder, so the server sees the same Python everywhere.
# BENCHBAR_MCP_CLI: tests only, a fake CLI stands in (a timeout, a hang).
cmd_mcp() {
  local py candidates=() found="" ver minor
  if command -v python3 >/dev/null 2>&1; then candidates+=("$(command -v python3)"); fi
  if ! fl_is_linux && xcode-select -p >/dev/null 2>&1 && [[ -x /usr/bin/python3 ]]; then candidates+=(/usr/bin/python3); fi
  for minor in 10 9; do
    for py in ${candidates[@]+"${candidates[@]}"}; do
      if "$py" -I -c "import sys; sys.exit(0 if sys.version_info >= (3, ${minor}) else 1)" >/dev/null 2>&1; then
        BENCHBAR="${BENCHBAR_MCP_CLI:-$FL_SELF}" BENCHBAR_VERSION="$FL_VERSION" exec "$py" -I "${SCRIPT_DIR}/lib/frappe-local/mcp.py" ${ARGS[@]+"${ARGS[@]}"}
      fi
    done
  done
  for py in ${candidates[@]+"${candidates[@]}"}; do
    ver="$("$py" -I -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])' 2>/dev/null || true)"
    found="${found:+${found}, }${py} (${ver:-not runnable})"
  done
  fl_die "python3 3.9 or newer is needed for benchbar mcp; found: ${found:-no python3}." "$(fl_is_linux && printf 'Install it: sudo apt-get install python3' || printf 'Install the Xcode Command Line Tools: xcode-select --install')"
}

cmd_status() {
  FL_CONTEXT_LIGHT=1
  fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"
  fl_cmd_status "$OPT_JSON"
}

# a version change is recorded (and its notices activated) on every command; a person's command
# prints the notices once, on stderr (notices.sh)
fl_notices_run

# --background: refused here when it cannot run unattended, else started detached; the caller gets the
# op_id at once and the stream goes to the operation's own output (ops.sh)
if [[ "$OPT_BACKGROUND" == "1" ]]; then
  fl_lab_gate "${FL_JSON_KEY:-$COMMAND}"
  # a lease stops it here, with the holder, and not in the detached run the caller would then have to poll
  fl_lease_gate
  [[ "$FL_DRY_RUN" == "1" ]] || fl_noninteractive_preflight
  fl_op_background ${FL_ORIG_ARGS[@]+"${FL_ORIG_ARGS[@]}"}
fi

# the stream starts first, so that a refusal (the preflight) is a done line and not silence:
# install and adopt with --json before the log and the lock (fl_jsonl_start runs the preflight)
if [[ "$OPT_JSON" == "1" && ( "$COMMAND" == "install" || "$COMMAND" == "adopt" ) ]]; then
  fl_jsonl_start
else
  # the other commands that stream (or whose document the stream wraps)
  if [[ "$FL_JSON_MODE" == "stream" || ( "$FL_JSON_MODE" == "doc" && "$OPT_JSONL" == "1" ) ]]; then fl_jsonl_begin_generic; fi
  # the lab gate comes after the stream starts (a stream gets its done line, a --json
  # document its error object) and before the preflight (a lab that is off is exit 2, not
  # a missing input)
  fl_lab_gate "${FL_JSON_KEY:-$COMMAND}"
  # a lease on the bench or the site a changing command covers stops it here, before the missing inputs are
  # asked for, the lock and any change (lease.sh); a dry run and the reads pass
  fl_lease_gate
  fl_noninteractive_preflight
fi

# a command that changes things on a bench it picked on its own says which (and an agent must name one)
# (a guest's share commands act on somebody else's room, on no bench of this computer)
if [[ -z "$OPT_BENCH_DIR" ]] && ! { [[ "$COMMAND" == share ]] && fl_share_guest_sub "${ARGS[0]:-}"; }; then
  case "$COMMAND" in
    install|adopt|register|scan|self-update|labs|profile|ports|lan-guard|docs|report|help|commands|mcp|where|mariadb-password) ;;
    *)
      fl_cmd_attr_v FL_GUESS_MUT "$(fl_cmd_key_for "$COMMAND" "${ARGS[0]:-}" || true)" mutating
      if [[ "$FL_GUESS_MUT" == "yes" && " ${ARGS[*]:-} " != *" --all "* ]]; then fl_bench_guess_gate; fi ;;
  esac
fi

case "$COMMAND" in
  ports)
    if [[ "${ARGS[0]:-}" == apply || "${ARGS[0]:-}" == mode ]]; then
      fl_log_init "${FL_STATE_DIR}/logs"
      fl_lock_acquire "${FL_STATE_DIR}/lock"
    fi ;;
  register|self-update)
    # self-update --check only asks GitHub (one curl of up to 10 s) and writes nothing: no run lock, so a
    # check never holds up an up or a repair, and no run log, so a poll leaves no file behind
    if [[ "$COMMAND" == "self-update" && " ${ARGS[*]:-} " == *" --check "* ]]; then :; else
      fl_log_init "${FL_STATE_DIR}/logs"
      fl_lock_acquire "${FL_STATE_DIR}/lock"
    fi ;;
  # labs on and off write the state file and off may stop a share; list and status read
  labs)
    if [[ "${ARGS[0]:-}" == "on" || "${ARGS[0]:-}" == "off" ]]; then
      fl_log_init "${FL_STATE_DIR}/logs"
      fl_lock_acquire "${FL_STATE_DIR}/lock"
    fi ;;
  # doctor reads; --ack and --unack write the bench's state file, under the lock
  doctor)
    if [[ -n "$OPT_ACK" || -n "$OPT_UNACK" ]]; then
      fl_log_init "${FL_STATE_DIR}/logs"
      fl_lock_acquire "${FL_STATE_DIR}/lock"
    fi ;;
  share)
    # users, preflight, status, people and log read; setup makes the copy and the identity, start the
    # job, teardown drops the copy and the share folder. stop, extend and the room's changes take no lock:
    # a long setup or start must never keep a share from being stopped or a person from being removed.
    # code, invite and open-as never open a run log: they handle the room code and a session id.
    # Neither do the guest's join, leave and forget: join handles the code, and all three act on no bench.
    case "${ARGS[0]:-}" in
      setup|start|teardown)
        fl_log_init "${FL_STATE_DIR}/logs"
        fl_lock_acquire "${FL_STATE_DIR}/lock" ;;
      stop|extend|lock|unlock|remove|revoke|assign) fl_log_init "${FL_STATE_DIR}/logs" ;;
    esac ;;
  lan-guard)
    case "${ARGS[0]:-}" in install|remove|allow-node) fl_log_init "${FL_STATE_DIR}/logs" ;; esac ;;
  # forget, remove, scratch and gc change the list of benches and the state folder (a plan too: it reads under the lock)
  bench)
    fl_log_init "${FL_STATE_DIR}/logs"
    fl_lock_acquire "${FL_STATE_DIR}/lock" ;;
  # run: the allow list decides (refused here with exit 64, before the lock); a run that executes has a
  # log of its own, and one that changes things takes the lock; a plan and a read take none
  run)
    fl_run_prepare
    if [[ "$RUN_EXECUTES" == "1" ]]; then
      fl_log_init "${FL_STATE_DIR}/logs"
      [[ "$RUN_CHANGES" != "yes" ]] || fl_lock_acquire "${FL_STATE_DIR}/lock"
    fi ;;
  site|app|profile|lock)
    # the list, show and check commands are read only, and so is a --plan
    # and "app focus" without an app name (the focus listing, with or
    # without --fetch: its one write, FETCHED_AT, goes through the key-value
    # file's own lock); the others change things
    if [[ "${ARGS[0]:-list}" != "list" && "${ARGS[0]:-}" != "show" && "${ARGS[0]:-}" != "check" && "${ARGS[0]:-}" != "backups" && "${ARGS[0]:-}" != "snapshots" \
      && " ${ARGS[*]:-} " != *" --plan "* && ! ( "${ARGS[0]:-}" == "open-as" && "${ARGS[1]:-}" == "status" ) ]] && ! fl_app_focus_is_listing "${ARGS[@]+"${ARGS[@]}"}"; then
      fl_log_init "${FL_STATE_DIR}/logs"
      fl_lock_acquire "${FL_STATE_DIR}/lock"
    fi
    ;;
  # fg stops the background bench first (a down), so it holds the lock until
  # just before it execs honcho (fl_cmd_fg releases it there)
  install|adopt|service|repair|up|down|restart|autostart|listen|uninstall-service|pull|fg)
    [[ "$FL_JSONL_KIND" == "own" ]] || fl_log_init "${FL_STATE_DIR}/logs"
    fl_lock_acquire "${FL_STATE_DIR}/lock"
    ;;
  *) ;;
esac

# a detached run (--background) says "running" now: it holds the lock, so it was not refused (ops.sh)
fl_op_running

# BENCHBAR_SUDO=env: the sudo password is checked once, before anything changes
# (repair does it in cmd_repair, once its events have started)
case "$COMMAND ${ARGS[0]:-}" in
  "install "*|"adopt "*|"service "*|"site add"|"ports apply") fl_sudo_env_preflight ;;
esac
# site add and ports apply run no sudo step on Linux (no /etc/hosts line): the checked password is not kept
case "$COMMAND ${ARGS[0]:-}" in
  "site add"|"ports apply") fl_sudo_phase_done ;;
esac

case "$COMMAND" in
  # exit by hand: install's own codes (2 the password, 1 a cancel) must not
  # pass through the ERR trap, which maps an incidental 2 to 1
  install) cmd_install || exit $? ;;
  adopt) cmd_adopt "${ARGS[0]:-}" ;;
  service) cmd_service ;;
  mariadb-password) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_mariadb_password ;;
  # exit 1 by hand: a failing check must not reach the ERR trap, whose
  # "[FAIL] Last command failed" line would follow the JSON on stdout
  doctor) cmd_doctor || exit 1 ;;
  repair) cmd_repair || exit $? ;;
  status) cmd_status ;;
  stats) FL_CONTEXT_LIGHT=1; fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_stats ;;
  list) FL_CONTEXT_LIGHT=1; fl_cmd_list "$OPT_JSON" ;;
  ports)
    [[ "${ARGS[0]:-}" == check ]] && FL_CONTEXT_LIGHT=1
    fl_cmd_ports ${ARGS[@]+"${ARGS[@]}"} || exit $? ;;
  scan) fl_cmd_scan "${ARGS[0]:-}" ;;
  register) fl_cmd_register ${ARGS[@]+"${ARGS[@]}"} ;;
  up) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_up ${ARGS[@]+"${ARGS[@]}"} ;;
  down) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_down ;;
  restart) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_restart ;;
  # exit 1 by hand (not ready in time): no ERR trap line after the document
  wait) FL_CONTEXT_LIGHT=1; fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_wait ${ARGS[@]+"${ARGS[@]}"} || exit 1 ;;
  logs) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_logs ${ARGS[@]+"${ARGS[@]}"} ;;
  fg) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_fg ;;
  watch) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_watch ;;
  autostart) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_autostart "${ARGS[0]:-}" ;;
  listen) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_listen "${ARGS[0]:-}" ;;
  uninstall-service)
    if [[ " ${ARGS[*]:-} " == *" --all "* ]]; then
      [[ -z "$OPT_BENCH_DIR" ]] || fl_die "uninstall-service takes --all or --bench-dir, not both." "Every bench: benchbar uninstall-service --all. One bench: benchbar uninstall-service --bench-dir PATH."
      fl_cmd_uninstall_service_all
    else
      fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_uninstall_service
    fi ;;
  # path only names the folder (benchcd runs it): no site, ports, profile or rendered templates
  # (--profile still checks the name: the full context, and a full load)
  path)
    if [[ -n "$OPT_PROFILE" ]]; then fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; else fl_bench_detect "$OPT_BENCH_DIR"; fi
    printf '%s\n' "$FL_BENCH_DIR" ;;
  console) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_console ${ARGS[@]+"${ARGS[@]}"} ;;
  run) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_run || exit $? ;;
  open) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_open ${ARGS[@]+"${ARGS[@]}"} ;;
  users) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_users ${ARGS[@]+"${ARGS[@]}"} ;;
  share) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_share ${ARGS[@]+"${ARGS[@]}"} ;;
  lan-guard) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_lan_guard ${ARGS[@]+"${ARGS[@]}"} ;;
  db) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_db ${ARGS[@]+"${ARGS[@]}"} ;;
  bench)
    # forget and remove name the bench by PATH, the others work on every known bench (gc) or on PATH (scratch)
    case "${ARGS[0]:-}" in
      forget|remove|scratch)
        # PATH may come after --apply TOKEN: the same parse as the command's own finds it
        fl_lc_parse "${ARGS[@]:1}"
        if [[ -n "$LC_PATH" ]]; then OPT_BENCH_DIR="$LC_PATH"; fi
        fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE" ;;
    esac
    fl_cmd_bench ${ARGS[@]+"${ARGS[@]}"} ;;
  site) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_site ${ARGS[@]+"${ARGS[@]}"} ;;
  app) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_app ${ARGS[@]+"${ARGS[@]}"} ;;
  profile) fl_cmd_profile ${ARGS[@]+"${ARGS[@]}"} ;;
  # status exits 1 for a lab that is off, without the ERR trap's line
  labs) FL_DONE_NO_BENCH=1; fl_cmd_labs ${ARGS[@]+"${ARGS[@]}"} || exit $? ;;
  # leases are benchbar's own state, under a lock of their own: no run lock, no bench context
  lease) fl_cmd_lease ${ARGS[@]+"${ARGS[@]}"} ;;
  notices) FL_DONE_NO_BENCH=1; fl_cmd_notices ${ARGS[@]+"${ARGS[@]}"} ;;
  # like doctor: drift exits 1 without the ERR trap's line after the JSON
  lock) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_lock ${ARGS[@]+"${ARGS[@]}"} || exit 1 ;;
  pull) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_pull ${ARGS[@]+"${ARGS[@]}"} ;;
  report) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_report ${ARGS[@]+"${ARGS[@]}"} ;;
  docs) fl_cmd_docs ${ARGS[@]+"${ARGS[@]}"} ;;
  self-update) fl_cmd_self_update ${ARGS[@]+"${ARGS[@]}"} || exit 1 ;;
  where) cmd_where ;;
  commands) if [[ "$OPT_JSON" == "1" ]]; then fl_commands_json; else fl_cmd_visible_table | awk -F'~' '$1 == "cmd" { printf "%-22s %s\n", $2, $4 }'; fi ;;
  mcp) cmd_mcp ;;
  # a run that is not done is exit 1 without the ERR trap's line, like doctor
  op) fl_cmd_op ${ARGS[@]+"${ARGS[@]}"} || exit 1 ;;
  history) fl_cmd_history ${ARGS[@]+"${ARGS[@]}"} ;;
  help) usage ;;
  *) fl_die "Unknown command: ${COMMAND}" "Run: benchbar --help" ;;
esac
