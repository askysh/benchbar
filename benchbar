usage() {
  cat <<USAGE
benchbar ${FL_VERSION}: local Frappe/ERPNext bench on macOS, in the background.

Usage: benchbar <command> [options]

Setup
  install             Run phase 00 (system deps), 01 (bench and site) and the
                      background service. Safe to re-run: only changes what changed.
  adopt PATH          Register an existing bench: Procfile.lean, runner, agent, helpers.
                      Shows the plan and asks; never runs migrate, build or update.
  service             Install or refresh only the background service (phase 02).
  doctor              Read-only health report. Exit 1 when something FAILs.
                      --fix-hints: only the fix commands of FAIL and WARN checks, one per line.
                      --fetch: git fetch the branches of the apps your focus apps need first
                      (without it doctor never touches the network).
  ports setup -- PATH ...
                      Preview management/port changes, confirm once, then apply (--dry-run: preview only)
  ports plan -- PATH ...
                      Show the same read-only preview (--json: machine-readable plan and token)
  ports check         Check conflicts for --bench-dir PATH (--json)
  ports mode automatic|fixed
                      Keep automatic or fixed ports for --bench-dir PATH
  ports apply TOKEN --yes -- PATH ...
                      Apply a previously reviewed JSON plan; refuse stale approvals
  report              Redacted diagnostics zip on the Desktop for bug reports (--print: to the terminal,
                      --json: {"zip": path, "redactions": n} for the app and scripts).
  repair              Apply only the fixes doctor flagged, in dependency order.
  uninstall-service   Remove the agent, runner, Procfile.lean and shell helpers.
                      --all: every bench with a benchbar agent, after one question (before
                      brew uninstall benchbar: brew cannot stop the agents itself).
  self-update         Update the benchbar CLI and the BenchBar app with the one line installer,
                      after asking (--check: this version against the latest, --json, --dry-run).
                      A Homebrew install runs brew upgrade askysh/tap/benchbar instead.
                      Never touches a bench; never runs bench update.
  where               How this CLI was installed (homebrew, managed, checkout, other), the path
                      it records for itself, its state folder and the BenchBar app (--json).

Daily
  up                  Start the bench in the background (benchup).
  down                Stop it and keep it stopped across reboots (benchdown).
  restart             Restart it, for example after changing Python code.
  status              State, pid, stop reason, site ping (benchstatus).
  list                Every bench benchbar knows about.
  scan PATH           Find benches recursively in a folder (read only; --json).
  register PATH ...   Remember selected benches without changing their services.
  logs                Tail logs/bench.log. Flags: --worker, --worker-error, --previous, -n50, --no-follow,
                      --process web|worker|socketio|schedule (with --json: the lines as JSON)
  fg                  Stop the service and run honcho in the foreground.
  watch               Run bench watch for asset rebuilds.
  autostart on|off    Whether the bench may come back after login.
  path                Print the bench directory (used by benchcd).
  site list           The bench's sites; the default one is what benchup waits for.
  site add NAME       bench new-site (Keychain MariaDB password), the hosts line, and
                      --bundle NAME or --apps "a b" from apps/. The default stays.
  site default NAME   Make NAME the default site (bench use, runner, benchup, the app).
  site hosts          Add a 127.0.0.1 line for every site to /etc/hosts (sudo, once).
  site backup NAME    bench --site NAME backup (--with-files for the uploads too; --json).
  site backups NAME   The site's backups, newest first: time, size, with files (--json).
  site drop NAME      bench drop-site: a backup with files first, the folder moved to
                      archived/sites, the hosts line removed. Needs --confirm-site NAME;
                      the default site also needs --new-default OTHER (--dry-run, --json).
  console             bench --site SITE console: a Python shell with frappe (--site S).
  db                  bench --site SITE mariadb: the site's database with its own user (--site S).
  mariadb-password    Print the MariaDB root password kept in the Keychain (asks first).
  mcp                 Model Context Protocol server on stdio for coding agents
                      (claude mcp add benchbar -- benchbar mcp). Read tools, up, down, restart,
                      app add from a reviewed plan.
  docs [TOPIC]        Open the documentation, or one topic's page (benchbar docs --help lists
                      them: install, doctor, apps, mcp, json ...); --print prints the URL.

Apps
  app list            Every app: branch, commit, local changes, the sites that have it
                      (--json; --no-sites reads the last site lists instead of asking bench).
  app add NAME|URL    bench get-app from config/apps.tsv or any git URL (GitHub, SSH, a
                      host alias), after checking access; --branch B, --name N, and
                      --site S or --all-sites to install it. Never replaces an app.
                      --dry-run --json: the plan with its token (required apps read from
                      hooks.py); --apply TOKEN --yes runs exactly that plan, no questions.
  app install NAME    Install an app of the bench on a site (--site S).
  app update NAME     Fast forward one app with a changelog first, back up the sites
                      that have it, then requirements, migrate and build (--skip-backup).
  app focus [NAME]    Focus apps (the ones you work on: local changes, another branch, a
                      commit of yours in 14 days): doctor warns when an app they need falls
                      behind. No NAME lists them (--list, --json, --fetch); NAME pins it as
                      focus, --auto infers again.
  app unfocus NAME    Pin NAME as not a focus app.

Team lockfile (benchbar.toml: each app's repo, branch and commit, and the sites)
  lock write          Write it from this bench (asks, shows the diff, backs up the old one);
                      --lock PATH (remembered), --no-commits, --allow-dirty.
  lock check          Compare the bench with it: read only, no network, no database.
                      Exit 1 on any difference (--json).
  lock apply          Clone missing apps, switch branches, fast forward to pinned commits,
                      then requirements and build. Never touches a site or local work.

Team profiles
  profile list        Built in and team profiles, with where each comes from (--json).
  profile show NAME   What a profile installs: base, Python, Node, MariaDB, apps.
  profile create NAME --from-bench PATH [--dir DIR]
                      Write a team profile from a bench (read only: app repos and
                      branches, the base from its frappe version). install --profile NAME
                      then builds the same bench on another Mac.
  profile export NAME [--out FILE] [--branch APP=BR]... [--drop APP]... [--plan]
                      A copy to share: SSH aliases resolved, each repo's default branch,
                      access (public, private, personal) and requires per app.
  profile import FILE|URL [--as NAME] [--plan]
                      Add a profile someone sent (https only, 64 KB at most); checks
                      which repos you can read. A GitHub page URL is fetched raw.
  profile subscribe GIT_URL [--plan]
                      Clone a team's config repo; its profiles join the lookup path.
  profile update NAME|--all [--plan]
                      Fetch an import or subscription again, show the diff, ask.
  profile remove NAME Move an import or a whole subscription aside.
  profile check NAME  Can git read every repo with your credentials? (--json)

Production copy
  pull HOST:SITE      Copy a production site over SSH into a NEW local site: the latest
                      backup on the server (nothing written there), the encryption key,
                      email muted and the scheduler paused. HOST is from ~/.ssh/config.
    --as NAME         Local site name (default: SITE.local)
    --from-dir DIR    A backup set downloaded by hand (Frappe Cloud), no SSH
    --remote-bench D  The bench folder on the server (default ~/frappe-bench)
    --new-backup      Run bench backup on the server first (it also deletes older
                      backups there); asks for the site name, or --confirm-site SITE
    --replace         Restore over an existing local site, after backing it up
    --skip-app APP    Restore without APP (its tables stay behind as orphans)
    --no-files        Database only; --keep-scheduler, --keep-staging

Options
  --bench-dir DIR     Bench to act on (default: remembered, or auto-detected)
  --site NAME         Site name (default: remembered, or from the bench)
  --profile NAME      Release profile for install/repair (default: v15-lts), or a team
                      profile (~/.config/benchbar/profiles/NAME.toml, BENCHBAR_PROFILE_PATH)
  --bundle NAME       App bundle for install (minimal, common, extended)
  --make-default      install, adopt, service: make this the default bench even when
                      another one is already the default
  --with-schedule     service: add the scheduler to Procfile.lean (per bench, kept by repair)
  --without-schedule  service: remove it again (the default)
  --port-offset N     install, adopt, service: use port block N (web 8000+N, socketio 9000+N,
                      redis 11000+N and 13000+N). Default: keep the ports, or the next
                      free block when another bench already uses them
  --dry-run           Print the full plan, change nothing
  --offline           install: skip the remote branch checks (also OFFLINE=1 or BENCHBAR_OFFLINE=1)
  -y, --yes           Do not ask; secrets must come from the environment
  --json              Versioned JSON for list, status and doctor; JSON lines for pull
                      (docs/json-schema.md)
  --plain             No colors or spinners (also: NO_COLOR=1, or a non-TTY)
  -h, --help          This help
  --version           Print the version (and the BenchBar app's, when it is installed)

Shell helpers (written to your shell rc by install or repair):
  benchup benchdown benchrestart benchstatus benchlogs benchfg benchwatch benchdoctor benchcd

Documentation: $(fl_docs_url /)
USAGE
}

# benchbar --version: the first line stays "benchbar X.Y.Z" (the app and
# scripts read it); the installed app's version follows on its own line.
fl_print_version() {
  local app tab=$'\t'
  printf 'benchbar %s\n' "$FL_VERSION"
  app="$(fl_app_bundle_info)"
  [[ -n "$app" ]] && printf 'BenchBar app %s (%s)\n' "${app%%"$tab"*}" "${app#*"$tab"}"
  return 0
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --bench-dir) OPT_BENCH_DIR="${2:-}"; shift 2 ;;
    --bench-dir=*) OPT_BENCH_DIR="${1#*=}"; shift ;;
    --site) OPT_SITE="${2:-}"; shift 2 ;;
    --site=*) OPT_SITE="${1#*=}"; shift ;;
    --profile) OPT_PROFILE="${2:-}"; shift 2 ;;
    --profile=*) OPT_PROFILE="${1#*=}"; shift ;;
    --bundle) OPT_BUNDLE="${2:-}"; shift 2 ;;
    --bundle=*) OPT_BUNDLE="${1#*=}"; shift ;;
    --dry-run) FL_DRY_RUN=1; shift ;;
    --offline) OFFLINE=1; shift ;;
    --make-default) FL_MAKE_DEFAULT=1; shift ;;
    --with-schedule) FL_SCHEDULER=on; shift ;;
    --without-schedule) FL_SCHEDULER=off; shift ;;
    --port-offset) OPT_PORT_OFFSET="${2:-}"; shift 2 ;;
    --port-offset=*) OPT_PORT_OFFSET="${1#*=}"; shift ;;
    -y|--yes) FL_ASSUME_YES=1; shift ;;
    --json) OPT_JSON=1; shift ;;
    --fix-hints) OPT_FIX_HINTS=1; shift ;;
    --ping) OPT_PING=1; shift ;;
    --fetch) FL_FETCH=1; shift ;;
    --plain|--no-color) FL_PLAIN=1; fl_ui_init; shift ;;
    --version) fl_print_version; exit 0 ;;
    # benchbar docs --help lists the topics; every other --help is this one
    -h|--help) if [[ "$COMMAND" == "docs" ]]; then ARGS+=("$1"); shift; else usage; exit 0; fi ;;
    --) shift; ARGS+=("$@"); break ;;
    -*)
      if [[ -n "$COMMAND" ]]; then ARGS+=("$1"); shift; else fl_die "Unknown option: $1" "Run: benchbar --help"; fi ;;
    *)
      if [[ -z "$COMMAND" ]]; then COMMAND="$1"; else ARGS+=("$1"); fi
      shift ;;
  esac
done
export FL_DRY_RUN FL_ASSUME_YES FL_MAKE_DEFAULT

[[ -n "$COMMAND" ]] || { usage; exit 0; }

fl_mode_name() {
  if [[ "$FL_DRY_RUN" == "1" ]]; then printf 'dry-run'; else printf '%s' "$COMMAND"; fi
}

fl_cleanup() {
  local code=$?
  fl_spinner_stop
  # pull closes its SSH connection and ends its JSON stream with "done"
  fl_pull_on_exit "$code"
  # a setup Redis started for site add goes, however the command ends
  fl_bench_redis_down >/dev/null 2>&1 || true
  fl_sudo_end
  fl_lock_release
}
trap fl_cleanup EXIT
trap fl_on_error ERR

fl_next_steps_box() {
  fl_box "Next steps" \
    "source $(fl_rc_file)      (once, so benchup and friends exist)" \
    "benchup                     start the bench in the background" \
    "open $(fl_site_url)" \
    "benchstatus / benchlogs     check on it" \
    "benchrestart                after changing Python code" \
    "benchwatch                  while editing JS or CSS"
}

fl_run_phase_script() {
  # fl_run_phase_script SCRIPT ARGS... : streams the phase script's output
  local script="$1" code=0
  shift
  FL_LAST_COMMAND="${script} $*"
  fl_log "phase: ${script} $*"
  "$script" "$@" || code=$?
  return "$code"
}

# One sudo prompt for the whole install: ask up front when a step ahead will
# need it (the wkhtmltopdf package, the /etc/hosts line), keep it alive, and
# let the phase scripts inherit the session.
fl_install_sudo_upfront() {
  local reasons=()
  [[ "$FL_DRY_RUN" == "1" ]] && return 0
  # only when phase 00 will get as far as the installer in this run: without
  # Rosetta and without a way to agree to it, or after a declined download,
  # the package is skipped and a sudo prompt for it would be asked for nothing
  fl_wkhtmltopdf_will_install && reasons+=("install the patched wkhtmltopdf package (installer -pkg)")
  fl_hosts_has_site || reasons+=("add '127.0.0.1 ${FL_SITE}' to ${FL_HOSTS_FILE}")
  [[ "${#reasons[@]}" -gt 0 ]] || return 0
  fl_sudo_begin "${reasons[@]}" || true
}

# fl_remember_bench: this bench's own settings, and the default bench when
# fl_remember_default allows it. Returns 1 when another bench stays default.
fl_remember_bench() {
  local code=0
  fl_bench_state_migrate "$FL_BENCH_DIR"
  fl_remember_default "$FL_BENCH_DIR" || code=1
  fl_bstate_set SITE_NAME "$FL_SITE"
  fl_bstate_set PROFILE "$FL_PROFILE"
  # the team profile it follows (PROFILE is its base); a built in --profile clears it
  if [[ -n "$FL_TEAM_PROFILE" || -n "$OPT_PROFILE" ]]; then fl_bstate_set TEAM_PROFILE "$FL_TEAM_PROFILE"; fi
  # a bench set up before 0.4 has no MariaDB formula stored: the running
  # server's, when the profile accepts it, else the profile's own
  if [[ -z "$(fl_bstate_get MARIADB_FORMULA)" ]]; then
    fl_mariadb_prefer_running
    [[ "$FL_MARIADB_SOURCE" == "running" ]] && fl_bstate_set MARIADB_FORMULA "$FL_MARIADB_FORMULA"
  fi
  # the shell block follows the default bench, which may just have changed
  fl_render_all
  return "$code"
}

cmd_install() {
  local code=0 args00=() args01=() bundle
  local profile_name
  fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"
  profile_name="$FL_PROFILE"
  if [[ -n "$FL_TEAM_PROFILE" ]]; then
    # the team profile's site name, unless one was given or remembered
    [[ -n "$FL_TEAM_SITE" && "$FL_SITE_SOURCE" == "default" ]] && FL_SITE="$FL_TEAM_SITE"
    if [[ -z "$FL_SCHEDULER" && -n "$FL_TEAM_SCHEDULER" && -z "$(fl_bstate_get SCHEDULER)" ]]; then
      FL_SCHEDULER=off; [[ "$FL_TEAM_SCHEDULER" == "true" ]] && FL_SCHEDULER=on
    fi
    profile_name="$FL_TEAM_PROFILE"
    fl_header "benchbar install" "$(fl_mode_name)" "${FL_TEAM_PROFILE} (team, on ${FL_PROFILE})" "$FL_BENCH_DIR" "$FL_SITE"
    fl_info "team profile ${FL_TEAM_PROFILE_FILE}"
  else
    fl_header "benchbar install" "$(fl_mode_name)" "$(fl_profile_display)" "$FL_BENCH_DIR" "$FL_SITE"
  fi
  fl_steps_define "System dependencies (00-mac-system-deps.sh)" "Bench and site (01-install-bench-and-site.sh)" "Background service"
  fl_steps_print_plan
  fl_install_sudo_upfront

  # the phases load a team profile themselves (its base for 00, its apps for 01)
  args00=(--profile "$profile_name"); args01=(--profile "$profile_name")
  [[ "$FL_DRY_RUN" == "1" ]] && { args00+=(--dry-run); args01+=(--dry-run); }
  [[ "$FL_ASSUME_YES" == "1" ]] && { args00+=(--yes); args01+=(--yes); }
  [[ "$OFFLINE" == "1" ]] && { args00+=(--offline); args01+=(--offline); }
  bundle="${OPT_BUNDLE:-$(fl_bstate_get APP_BUNDLE 2>/dev/null || true)}"
  bundle="${bundle:-$FL_TEAM_BUNDLE}"

  fl_step_begin 0
  if fl_run_phase_script "${SCRIPT_DIR}/00-mac-system-deps.sh" "${args00[@]}"; then
    fl_step_end "done"
  else
    code=$?
    if [[ "$code" == "2" ]]; then
      fl_step_end warning "manual steps pending"
      fl_steps_summary
      fl_box "Stopped" "Complete the PENDING MANUAL STEPS printed above, then run this command again." \
        "System dependencies were set up as far as possible; no bench or site was created."
      return 2
    fi
    fl_step_end failed
    fl_steps_summary
    return "$code"
  fi

  fl_step_begin 1
  local web_port=""
  [[ "$OPT_PORT_OFFSET" =~ ^[0-9]+$ ]] && web_port=$((FL_PORT_BASE_WEB + OPT_PORT_OFFSET))
  if BENCH_DIR="$FL_BENCH_DIR" SITE_NAME="$FL_SITE" APP_BUNDLE="${bundle:-minimal}" BENCHBAR_WEB_PORT="$web_port" \
     fl_run_phase_script "${SCRIPT_DIR}/01-install-bench-and-site.sh" "${args01[@]}"; then
    fl_step_end "done"
  else
    code=$?
    if [[ "$code" == "2" ]]; then
      fl_step_end warning "manual steps pending"
      fl_steps_summary
      fl_box "Stopped" "The MariaDB root password is unknown; see above for how to pass it," "then run this command again. No bench or site was created."
      return 2
    fi
    if [[ "$code" == "3" ]]; then
      # declined at the plan: no bench, so nothing to remember and no service
      fl_step_end skipped "cancelled"
      fl_steps_summary
      fl_warn "Cancelled. No bench or site was created; the system dependencies of step 1 stay in place."
      return 1
    fi
    fl_step_end failed
    fl_steps_summary
    return "$code"
  fi
  fl_remember_bench || fl_info "the default bench stays $(fl_state_get BENCH_DIR) (--make-default changes it)"
  if [[ -n "$FL_SCHEDULER" ]]; then fl_bstate_set SCHEDULER "$FL_SCHEDULER"; fi

  fl_step_begin 2
  fl_context_init "$FL_BENCH_DIR" "$FL_SITE" "$FL_PROFILE"
  # no MariaDB formula saved yet (a dry run saves nothing): check against the
  # server phase 00 chose, not the profile default. Setup may look at 3306.
  [[ -n "$FL_MARIADB_FORMULA_PINNED" ]] || fl_mariadb_prefer_running
  if [[ "$FL_DRY_RUN" == "1" && ! -d "$FL_BENCH_DIR" ]]; then
    fl_info "dry-run: the bench does not exist yet, so the service plan is shown against an empty bench"
  fi
  FL_SKIP_PLAN_CONFIRM=1
  if [[ -d "$FL_BENCH_DIR/sites" ]]; then
    fl_ports_plan "$OPT_PORT_OFFSET" || { fl_step_end failed; fl_steps_summary; return 1; }
  elif [[ "$FL_DRY_RUN" == "1" && -n "$OPT_PORT_OFFSET" ]]; then
    # the bench is not there yet: show the plan with the ports it will get,
    # not the defaults (the real run moves them once the bench exists)
    fl_ports_plan "$OPT_PORT_OFFSET" || { fl_step_end failed; fl_steps_summary; return 1; }
    if [[ -n "$FL_PORT_TARGET" ]]; then
      read -r FL_WEB_PORT FL_SOCKETIO_PORT FL_REDIS_QUEUE_PORT FL_REDIS_CACHE_PORT <<<"$(fl_port_block "$FL_PORT_TARGET")"
      FL_REDIS_SOCKETIO_PORT="$FL_REDIS_CACHE_PORT"
      fl_info "dry-run: the new bench gets port block ${FL_PORT_TARGET} (web ${FL_WEB_PORT}, socketio ${FL_SOCKETIO_PORT})"
      FL_PORT_TARGET=""
      fl_render_all
    fi
  fi
  # the engine lists and times its own actions; the install's three steps
  # come back afterwards for the one Summary at the end
  fl_steps_push
  if FL_ENGINE_NO_SUMMARY=1 FL_PLAN_CHECKS="port_block" fl_repair_engine "Background service" system service; then
    fl_steps_pop
    fl_pm_remember
    fl_step_end "done"
  else
    fl_steps_pop
    fl_step_end warning "see above"
    code=1
  fi
  fl_steps_summary
  fl_next_steps_box
  return "$code"
}

cmd_service() {
  fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"
  fl_require_bench
  fl_header "benchbar service" "$(fl_mode_name)" "$(fl_profile_display)" "$FL_BENCH_DIR" "$FL_SITE"
  # validate a requested block before anything is remembered
  if [[ -n "$OPT_PORT_OFFSET" ]]; then
    fl_ports_plan "$OPT_PORT_OFFSET" || return 1
  fi
  fl_remember_bench || true
  if [[ -n "$FL_SCHEDULER" ]]; then
    # stored now (not in a dry run) and rendered for the plan either way
    fl_bstate_set SCHEDULER "$FL_SCHEDULER"
    fl_render_all
  fi
  if FL_PLAN_CHECKS="port_block" fl_repair_engine "Background service" service; then
    fl_pm_remember
    if [[ -n "$FL_SCHEDULER" && "${FL_DRY_RUN:-0}" != "1" ]] && fl_bench_is_running; then
      fl_warn "the running bench still uses the old Procfile.lean; run: benchbar restart --bench-dir ${FL_BENCH_DIR}"
    fi
    fl_next_steps_box
    return 0
  fi
  return 1
}

# benchbar adopt PATH: register an existing bench without touching its data.
# Same engine as "service" (only the service group of checks and actions), so
# it never runs migrate, build, update or an env rebuild.
cmd_adopt() {
  local path="${1:-}"
  [[ -n "$path" ]] || fl_die "Usage: benchbar adopt <bench path>" "Example: benchbar adopt ~/frappe-bench"
  path="$(fl_abs_path "$path")"
  fl_is_bench_dir "$path" || fl_die "${path} is not a bench (no sites/common_site_config.json and no apps/frappe)." "Point adopt at the folder that holds apps/, sites/ and env/."
  fl_context_init "$path" "$OPT_SITE" "$OPT_PROFILE"
  fl_header "benchbar adopt" "$(fl_mode_name)" "$(fl_profile_display)" "$FL_BENCH_DIR" "$FL_SITE"
  fl_info "adopt only adds the background service files and remembers the bench."
  fl_info "apps/, env/, the sites and the databases are not touched; migrate, build and update never run."
  fl_info "only when another bench uses the same ports (or --port-offset is given) does it move the ports, with bench set-config -g."
  if [[ -z "$FL_HONCHO" ]]; then
    fl_warn "honcho was not found on PATH, in the pipx venv of frappe-bench or in ${FL_BENCH_DIR}/env; adopt does not install into env"
    fl_fix "pipx install honcho   (or: ${FL_SELF} repair, which installs it into the bench env), then benchbar adopt again"
  fi
  fl_ports_plan "$OPT_PORT_OFFSET" || return 1
  # the service group would install honcho into env when it is missing; adopt must not
  if FL_PLAN_CHECKS="port_block" FL_ENGINE_SKIP_ACTIONS="honcho_install honcho_setuptools" fl_repair_engine "Adopt" service; then
    fl_pm_remember
    # remembered only now: a cancelled plan must not make this the default bench
    if fl_remember_bench; then
      [[ "$FL_DRY_RUN" == "1" ]] || fl_ok "remembered ${FL_BENCH_DIR} (site ${FL_SITE}) as the default bench"
    else
      [[ "$FL_DRY_RUN" == "1" ]] || fl_ok "remembered ${FL_BENCH_DIR} (site ${FL_SITE}); the default bench stays $(fl_state_get BENCH_DIR) (--make-default changes it)"
    fi
    fl_next_steps_box
    return 0
  fi
  return 1
}

cmd_doctor() {
  local fails
  # --fix-hints: only the fix commands on stdout (fd 3), everything else,
  # a missing bench included, on stderr
  if [[ "$OPT_FIX_HINTS" == "1" ]]; then exec 3>&1 1>&2; FL_PLAIN=1; fl_ui_init; fi
  fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"
  fl_require_bench
  fl_doctor_run
  if [[ "$OPT_FIX_HINTS" == "1" ]]; then
    fl_doctor_print_fix_hints >&3
  elif [[ "$OPT_JSON" == "1" ]]; then
    fl_doctor_print_json
  else
    fl_header "benchbar doctor" "read-only" "$(fl_profile_display)" "$FL_BENCH_DIR" "$FL_SITE"
    fl_doctor_print
    if [[ -n "$(fl_doctor_actions)" ]]; then
      printf '\n'
      fl_info "run '${FL_SELF} repair' to apply the fixes marked above (dry-run: add --dry-run)"
    fi
  fi
  fails="$(fl_doctor_count fail)"
  [[ "$fails" == "0" ]]
}

# repair --json: events on stdout (docs/json-schema.md), the human text in
# the run's log. Without --yes or --dry-run nothing is applied: a reader
# that cannot answer the question gets the plan and exit code 1.
cmd_repair() {
  local code=0
  fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"
  fl_require_bench
  if [[ "$OPT_JSON" == "1" ]]; then
    exec 3>&1 1>>"${FL_LOG_FILE:-/dev/null}" 2>&1
    FL_JSON_EVENTS=1
    FL_PLAIN=1; fl_ui_init
    # the question would be invisible (the text goes to the log): without
    # --yes it is answered no
    [[ "$FL_ASSUME_YES" == "1" ]] || exec 0</dev/null
  fi
  fl_header "benchbar repair" "$(fl_mode_name)" "$(fl_profile_display)" "$FL_BENCH_DIR" "$FL_SITE"
  fl_repair_engine "Repair" || code=$?
  if [[ "$FL_JSON_EVENTS" == "1" && "${FL_DRY_RUN:-0}" != "1" ]]; then
    fl_event "{\"event\":\"done\",\"exit_code\":${code},\"log\":$(fl_json_str "${FL_LOG_FILE:-}")}"
  fi
  return "$code"
}

# benchbar where [--json]: how this CLI was installed and where its things
# are. Read only: no bench, no lock, no log.
cmd_where() {
  local info app_version="" app_path="" tab=$'\t' how
  [[ "${#ARGS[@]}" == "0" ]] || fl_die "Unexpected argument for where: ${ARGS[0]}" "Usage: benchbar where [--json]"
  if [[ "$FL_INSTALL_KIND" == app ]]; then
    # the app this CLI is part of, not the first one found
    app_path="${SCRIPT_DIR%/Contents/Resources/cli}"; app_version="$(fl_app_bundle_version_at "$app_path")"
  else
    info="$(fl_app_bundle_info)"
    if [[ -n "$info" ]]; then app_version="${info%%"$tab"*}"; app_path="${info#*"$tab"}"; fi
  fi
  if [[ "$OPT_JSON" == "1" ]]; then
    printf '{"schema_version":%d,"cli_version":%s,"install":%s,"self":%s,"state_dir":%s,"app_version":%s,"app_path":%s,"handoff_from":%s}\n' \
      "$FL_SCHEMA_VERSION" "$(fl_json_str "$FL_VERSION")" "$(fl_json_str "$FL_INSTALL_KIND")" "$(fl_json_str "$FL_SELF")" \
      "$(fl_json_str "$FL_STATE_DIR")" "$(fl_su_json_or_null "$app_version")" "$(fl_su_json_or_null "$app_path")" \
      "$(fl_su_json_or_null "$FL_HANDOFF_FROM")"
    return 0
  fi
  case "$FL_INSTALL_KIND" in
    homebrew) how="with Homebrew (brew upgrade askysh/tap/benchbar)" ;;
    managed) how="with the one line installer (benchbar self-update)" ;;
    app) how="inside BenchBar.app (it updates with the app: Sparkle or brew upgrade)" ;;
    checkout) how="as a git checkout (git pull)" ;;
    *) how="some other way" ;;
  esac
  printf 'benchbar %s, installed %s\n' "$FL_VERSION" "$how"
  printf '  install  %s\n' "$FL_INSTALL_KIND"
  printf '  self     %s\n' "$FL_SELF"
  [[ -z "$FL_HANDOFF_FROM" ]] || printf '  via      %s, which hands off to this CLI\n' "$FL_HANDOFF_FROM"
  printf '  state    %s\n' "$FL_STATE_DIR"
  if [[ -n "$app_path" ]]; then printf '  app      %s (%s)\n' "$app_path" "$app_version"; else printf '  app      not installed\n'; fi
}

cmd_status() {
  FL_CONTEXT_LIGHT=1
  fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"
  fl_cmd_status "$OPT_JSON"
}

case "$COMMAND" in
  ports)
    if [[ "${ARGS[0]:-}" == apply || "${ARGS[0]:-}" == mode ]]; then
      fl_log_init "${FL_STATE_DIR}/logs"
      fl_lock_acquire "${FL_STATE_DIR}/lock"
    fi ;;
  register) fl_lock_acquire "${FL_STATE_DIR}/lock" ;;
  site|app|profile|lock)
    # the list, show and check commands are read only, and so is a --plan; the others change things
    if [[ "${ARGS[0]:-list}" != "list" && "${ARGS[0]:-}" != "show" && "${ARGS[0]:-}" != "check" && "${ARGS[0]:-}" != "backups" \
      && " ${ARGS[*]:-} " != *" --plan "* ]]; then
      fl_log_init "${FL_STATE_DIR}/logs"
      fl_lock_acquire "${FL_STATE_DIR}/lock"
    fi
    ;;
  # fg stops the background bench first (a down), so it holds the lock until
  # just before it execs honcho (fl_cmd_fg releases it there)
  install|adopt|service|repair|up|down|restart|autostart|uninstall-service|pull|fg)
    fl_log_init "${FL_STATE_DIR}/logs"
    fl_lock_acquire "${FL_STATE_DIR}/lock"
    ;;
  *) ;;
esac

case "$COMMAND" in
  # exit by hand: install's own codes (2 the password, 1 a cancel) must not
  # pass through the ERR trap, which maps an incidental 2 to 1
  install) cmd_install || exit $? ;;
  adopt) cmd_adopt "${ARGS[0]:-}" ;;
  service) cmd_service ;;
  mariadb-password) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_mariadb_password ;;
  # exit 1 by hand: a failing check must not reach the ERR trap, whose
  # "[FAIL] Last command failed" line would follow the JSON on stdout
  doctor) cmd_doctor || exit 1 ;;
  repair) cmd_repair || exit $? ;;
  status) cmd_status ;;
  list) FL_CONTEXT_LIGHT=1; fl_cmd_list "$OPT_JSON" ;;
  ports)
    [[ "${ARGS[0]:-}" == check ]] && FL_CONTEXT_LIGHT=1
    fl_cmd_ports ${ARGS[@]+"${ARGS[@]}"} || exit $? ;;
  scan) fl_cmd_scan "${ARGS[0]:-}" ;;
  register) fl_cmd_register ${ARGS[@]+"${ARGS[@]}"} ;;
  up) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_up ;;
  down) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_down ;;
  restart) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_restart ;;
  logs) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_logs ${ARGS[@]+"${ARGS[@]}"} ;;
  fg) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_fg ;;
  watch) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_watch ;;
  autostart) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_autostart "${ARGS[0]:-}" ;;
  uninstall-service)
    if [[ " ${ARGS[*]:-} " == *" --all "* ]]; then
      [[ -z "$OPT_BENCH_DIR" ]] || fl_die "uninstall-service takes --all or --bench-dir, not both." "Every bench: benchbar uninstall-service --all. One bench: benchbar uninstall-service --bench-dir PATH."
      fl_cmd_uninstall_service_all
    else
      fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_uninstall_service
    fi ;;
  path) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; printf '%s\n' "$FL_BENCH_DIR" ;;
  console) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_console ${ARGS[@]+"${ARGS[@]}"} ;;
  db) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_db ${ARGS[@]+"${ARGS[@]}"} ;;
  site) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_site ${ARGS[@]+"${ARGS[@]}"} ;;
  app) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_app ${ARGS[@]+"${ARGS[@]}"} ;;
  profile) fl_cmd_profile ${ARGS[@]+"${ARGS[@]}"} ;;
  # like doctor: drift exits 1 without the ERR trap's line after the JSON
  lock) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_lock ${ARGS[@]+"${ARGS[@]}"} || exit 1 ;;
  pull) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_pull ${ARGS[@]+"${ARGS[@]}"} ;;
  report) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_report ${ARGS[@]+"${ARGS[@]}"} ;;
  docs) fl_cmd_docs ${ARGS[@]+"${ARGS[@]}"} ;;
  self-update) fl_cmd_self_update ${ARGS[@]+"${ARGS[@]}"} || exit 1 ;;
  where) cmd_where ;;
  mcp)
    # stdlib only Python 3.9+; the Command Line Tools' python3 is enough
    command -v python3 >/dev/null 2>&1 || fl_die "python3 is needed for benchbar mcp." "Install the Xcode Command Line Tools: xcode-select --install"
    BENCHBAR="${FL_SELF}" BENCHBAR_VERSION="$FL_VERSION" exec python3 "${SCRIPT_DIR}/lib/frappe-local/mcp.py" ;;
  help) usage ;;
  *) fl_die "Unknown command: ${COMMAND}" "Run: benchbar --help" ;;
esac
