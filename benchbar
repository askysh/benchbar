#!/usr/bin/env bash
#
# benchbar: one entrypoint (also installed as frappe-mac) for a local Frappe/ERPNext bench on macOS and Linux.
#
#   benchbar install        phases 00, 01 and the background service, idempotent
#   benchbar up | down      start or stop the bench in the background
#   benchbar doctor         read-only health report with exact fix commands
#   benchbar repair         apply only the fixes doctor flagged
#
# Runs on macOS /bin/bash 3.2. No dependencies beyond the ones the installer
# already needs.

# errtrace (-E): the ERR trap below fires inside functions too, so a failing command names itself
set -Eeuo pipefail

# BENCHBAR_SUDO_PASSWORD must not stay in the initial environment of this
# process: Linux keeps that copy in /proc/PID/environ for the whole run, and
# the pip, npm and bench get-app scripts of the same user could read it. So
# the first image reads the password, starts the second without the variable
# and hands it over on an inherited pipe (fd 9, a printf builtin writes it,
# never argv or a file); sudo-env.sh reads and closes it. The variable is
# gone in the second image, so this runs once. xtrace is off around it.
# (:+x, so an xtrace line shows "x" and not the value)
if [[ -n "${BENCHBAR_SUDO_PASSWORD:+x}" ]]; then
  FL__XT=0
  case "$-" in *x*) FL__XT=1; { set +x; } 2>/dev/null ;; esac
  if [[ "${BENCHBAR_SUDO:-}" == "env" ]]; then
    # a line break cannot ride the pipe (one line is read): only the fact goes
    # on, and fl_sudo_env_preflight refuses before anything runs
    case "$BENCHBAR_SUDO_PASSWORD" in *$'\n'*) export FL_SUDO_PW_NEWLINE=1 ;; esac
    exec 9< <(printf '%s\n' "$BENCHBAR_SUDO_PASSWORD")
    export FL_SUDO_PW_FD=9
  fi
  unset BENCHBAR_SUDO_PASSWORD
  if [[ "$FL__XT" == "1" ]]; then exec "$BASH" -x "${BASH_SOURCE[0]}" "$@"; fi
  exec "$BASH" "${BASH_SOURCE[0]}" "$@"
fi

FL_VERSION="0.8.3"

# Resolve the real script location even when invoked through a symlink
# (for example ~/.local/bin/frappe-mac).
# dirname by parameter expansion: every status poll of the app starts here
fl_resolve_self_dir() { case "$1" in */*) printf '%s' "${1%/*}" ;; *) printf '.' ;; esac; }
fl_resolve_self_once() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir="$(cd "$(fl_resolve_self_dir "$src")/" 2>/dev/null && pwd)" || return 1
    src="$(readlink "$src" 2>/dev/null)" || return 1
    [[ "$src" == /* ]] || src="${dir}/${src}"
  done
  dir="$(cd "$(fl_resolve_self_dir "$src")/" 2>/dev/null && pwd)" || return 1
  # the folder of this CLI's files, not one a link passed through
  [[ -f "${dir}/lib/frappe-local/install-kind.sh" ]] || return 1
  printf '%s' "$dir"
}
fl_resolve_self() {
  local i=0
  # the app's link in ~/.local/state/benchbar/bin is away for a moment while
  # the first run after an upgrade moves the state folder into place
  # (state.sh): a start in that moment tries again, up to 2 s. A normal
  # start resolves at the first try and starts no process for it.
  until fl_resolve_self_once; do
    if [[ "$i" -ge 20 ]]; then cd "$(fl_resolve_self_dir "${BASH_SOURCE[0]}")/" && pwd; return; fi
    sleep 0.1; i=$((i + 1))
  done
}
