# --ping: status asks every site (sites[].ping_code), not only the default one
OPT_PING=0
# --deep: status also asks the readiness parts that start programs (workers, stale code)
OPT_DEEP=0
# --fetch: doctor and app focus fetch the focus apps' dependencies (freshness.sh)
FL_FETCH=0
# install --frappe-commit SHA --erpnext-commit SHA: pin the clones
OPT_FRAPPE_COMMIT=""
OPT_ERPNEXT_COMMIT=""
# install --scratch [--ttl DAYS]: the bench expires; bench scratch PATH --ttl DAYS (lifecycle.sh)
OPT_SCRATCH=0
OPT_TTL=""
# confirmations come from flags only: a value left in the environment must
# never answer a question (--yes, --make-default, an approved port plan)
FL_ASSUME_YES=0
FL_MAKE_DEFAULT=0
# install --repair-bench: move an incomplete bench folder aside (phase 01 decides which)
OPT_REPAIR_BENCH=0
# install, adopt: --allow-windows-fs lets a bench live on the Windows file system under WSL
FL_ALLOW_WINDOWS_FS=0
# install (Linux): --allow-unsupported-distro tries a system other than Ubuntu 24.04
FL_ALLOW_UNSUPPORTED_DISTRO=0
FL_PORT_PLAN_APPROVED=0
# --offline, OFFLINE=1 or BENCHBAR_OFFLINE=1: install skips its remote
# checks (the phase scripts get --offline), doctor --fetch fetches nothing
OFFLINE="${OFFLINE:-0}"; [[ "${BENCHBAR_OFFLINE:-0}" == "1" ]] && OFFLINE=1
FL_SCHEDULER=""
# --lease ID (repeatable): the leases the caller holds, so a command may change what they cover.
# --break-lease: a person at a terminal goes ahead although a lease covers it (lease.sh)
OPT_LEASES=""
OPT_BREAK_LEASE=0
FL_SKIP_PLAN_CONFIRM=0
COMMAND=""
ARGS=()
# how many of ARGS come before a bare -- (-1: no --): what the unknown option check reads
FL_ARGS_FLAGS_N=-1

# --version, where, mcp and status: lib/frappe-local/cmd-where.sh (CORE-18). It is sourced here, before the
# command line is read, because --version needs fl_print_version; a lean start loads it too.
# shellcheck source=lib/frappe-local/cmd-where.sh
. "${SCRIPT_DIR}/lib/frappe-local/cmd-where.sh"

# fl_opt_value FLAG ARGC VALUE: a flag that takes a value has one, and the value is not the next
# option (benchbar where --bench-dir --json took --json for the folder). Exit 64, error_id
# missing_value, like any usage error (fl_usage_refuse; BENCHBAR_LENIENT_FLAGS does not cover it).
# Callers are plain statements of the main loop, and fl_usage_refuse ends in exit: it never relies
# on set -e, which bash switches off inside a function that an `if` or `||` calls.
fl_opt_value() {
  local key="" usage=""
  [[ "$2" -ge 2 && "$3" != -* ]] && return 0
  if [[ -n "$COMMAND" ]]; then key="$(fl_cmd_key_for "$COMMAND" "${ARGS[0]:-}")" || key=""; fi
  [[ -z "$key" ]] || fl_cmd_usage_v usage "$key"
  fl_usage_refuse missing_value "$1 needs a value." "${usage:+Usage: ${usage}. }Example: benchbar ${key:-COMMAND} $1 VALUE (or $1=VALUE). Every flag: benchbar ${key:-COMMAND} --help" "$key"
}

# the command line as it came: a usage error (fl_usage_refuse) reads --json and --for-agent from
# it, because the loop below may not have reached them yet
FL_ORIG_ARGS=("$@")
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --bench-dir) fl_opt_value "$1" "$#" "${2-}"; OPT_BENCH_DIR="$2"; shift 2 ;;
    --bench-dir=*) OPT_BENCH_DIR="${1#*=}"; shift ;;
    --site) fl_opt_value "$1" "$#" "${2-}"; OPT_SITE="$2"; shift 2 ;;
    --site=*) OPT_SITE="${1#*=}"; shift ;;
    --profile) fl_opt_value "$1" "$#" "${2-}"; OPT_PROFILE="$2"; shift 2 ;;
    --profile=*) OPT_PROFILE="${1#*=}"; shift ;;
    --bundle) fl_opt_value "$1" "$#" "${2-}"; OPT_BUNDLE="$2"; shift 2 ;;
    --bundle=*) OPT_BUNDLE="${1#*=}"; shift ;;
    --dry-run) FL_DRY_RUN=1; shift ;;
    --offline) OFFLINE=1; shift ;;
    --make-default) FL_MAKE_DEFAULT=1; shift ;;
    --repair-bench) OPT_REPAIR_BENCH=1; shift ;;
    --allow-windows-fs) FL_ALLOW_WINDOWS_FS=1; shift ;;
    --allow-unsupported-distro) FL_ALLOW_UNSUPPORTED_DISTRO=1; export BENCHBAR_ALLOW_UNSUPPORTED_DISTRO=1; shift ;;
    --with-schedule) FL_SCHEDULER=on; shift ;;
    --without-schedule) FL_SCHEDULER=off; shift ;;
    --port-offset) fl_opt_value "$1" "$#" "${2-}"; OPT_PORT_OFFSET="$2"; shift 2 ;;
    --port-offset=*) OPT_PORT_OFFSET="${1#*=}"; shift ;;
    -y|--yes) FL_ASSUME_YES=1; shift ;;
    --json) OPT_JSON=1; shift ;;
    --jsonl) OPT_JSON=1; OPT_JSONL=1; shift ;;
    --for-agent) OPT_FOR_AGENT=1; shift ;;
    --lease) [[ -n "${2:-}" && "${2:-}" != -* ]] || fl_die "--lease needs a lease id." "benchbar lease take returns one"; OPT_LEASES="${OPT_LEASES} $2"; shift 2 ;;
    --lease=*) OPT_LEASES="${OPT_LEASES} ${1#*=}"; shift ;;
    --break-lease) OPT_BREAK_LEASE=1; shift ;;
    --background) OPT_BACKGROUND=1; shift ;;
    --ack) fl_opt_value "$1" "$#" "${2-}"; OPT_ACK="$2"; shift 2 ;;
    --ack=*) OPT_ACK="${1#*=}"; shift ;;
    --unack) fl_opt_value "$1" "$#" "${2-}"; OPT_UNACK="$2"; shift 2 ;;
    --unack=*) OPT_UNACK="${1#*=}"; shift ;;
    --quick) OPT_QUICK=1; shift ;;
    --fix-hints) OPT_FIX_HINTS=1; shift ;;
    --prerequisites) OPT_PREREQ=1; shift ;;
    --ping) OPT_PING=1; shift ;;
    --deep) OPT_DEEP=1; shift ;;
    --fetch) FL_FETCH=1; shift ;;
    --frappe-commit) [[ -n "${2:-}" && "${2:-}" != -* ]] || fl_die "--frappe-commit needs a commit hash." "Example: benchbar install --frappe-commit 0123abc"; OPT_FRAPPE_COMMIT="$2"; shift 2 ;;
    --frappe-commit=*) OPT_FRAPPE_COMMIT="${1#*=}"; shift ;;
    --erpnext-commit) [[ -n "${2:-}" && "${2:-}" != -* ]] || fl_die "--erpnext-commit needs a commit hash." "Example: benchbar install --erpnext-commit 0123abc"; OPT_ERPNEXT_COMMIT="$2"; shift 2 ;;
    --erpnext-commit=*) OPT_ERPNEXT_COMMIT="${1#*=}"; shift ;;
    --scratch) OPT_SCRATCH=1; shift ;;
    --ttl) OPT_TTL="${2:-}"; shift 2 || shift ;;
    --ttl=*) OPT_TTL="${1#*=}"; shift ;;
    --plain|--no-color) FL_PLAIN=1; fl_ui_init; shift ;;
    --version) fl_print_version; exit 0 ;;
    # benchbar docs --help lists the topics; a command's --help is its entry in
    # commands.sh (after the loop: the subcommand may come later), else this one
    -h|--help) if [[ "$COMMAND" == "docs" || "$COMMAND" == "self-update" ]]; then ARGS+=("$1"); shift; else FL_WANT_HELP=1; shift; fi ;;
    # run keeps where "--" was: the words before it are benchbar's, the ones after it the bench command's
    --) shift; FL_ARGS_FLAGS_N="${#ARGS[@]}"; [[ "$COMMAND" != "run" ]] || FL_RUN_SEP="${#ARGS[@]}"; ARGS+=("$@"); break ;;
    -*)
      if [[ -n "$COMMAND" ]]; then ARGS+=("$1"); shift; else fl_usage_refuse unknown_flag "Unknown option: $1" "Run: benchbar --help"; fi ;;
    *)
      if [[ -z "$COMMAND" ]]; then COMMAND="$1"; else ARGS+=("$1"); fi
      shift ;;
  esac
done
export FL_DRY_RUN
# nothing can be asked of a run nobody watches: the questions are refused up front, as for an agent
if [[ "$OPT_BACKGROUND" == "1" ]]; then BENCHBAR_NONINTERACTIVE=1; export BENCHBAR_NONINTERACTIVE; fi
# the options after the command are the command's own: each is in its entry of commands.sh,
# else the run stops (exit 64) before anything is taken, started or written
[[ "$FL_WANT_HELP" == "1" || -z "$COMMAND" ]] || fl_args_validate
# the passwords stay shell variables of this process: the phase scripts get
# them on their own command line below, no other child (brew, pip, npm,
# yarn, bench get-app) sees them
export -n MARIADB_ROOT_PASSWORD ADMIN_PASSWORD

if [[ "$FL_WANT_HELP" == "1" ]]; then
  # a command of a lab that is off shows the refusal, not its help (but for the ones that undo the lab)
  [[ -z "$COMMAND" ]] || fl_lab_gate "$(fl_cmd_key_for "$COMMAND" "${ARGS[0]:-}" || printf '%s' "$COMMAND")"
  if [[ -n "$COMMAND" ]] && FL_HELP_KEY="$(fl_cmd_key_for "$COMMAND" "${ARGS[0]:-}")"; then fl_cmd_help "$FL_HELP_KEY"; else usage; fi
  exit 0
fi

[[ -n "$COMMAND" ]] || { usage; exit 0; }
# root owns files the user then cannot write (the state folder, logs, the bench lock): benchbar asks for sudo
# itself, for the few steps that need it. `doctor --prerequisites` only reads and reports, and its
# regular_user check is how a person learns that they ran it as root, so it is not refused.
if [[ "$COMMAND" != "help" ]] && ! [[ "$COMMAND" == "doctor" && "${OPT_PREREQ:-0}" == "1" ]]; then
  fl_refuse_root
fi

# status, list and the other readers are polled: they skip the table unless
# --for-agent asks for it
case "$COMMAND" in
  install|adopt|repair|pull|up|down|restart|wait|service|site|app|ports|share|lan-guard|labs|register|autostart|listen|uninstall-service|profile|lock|self-update|run|bench|db|lease) fl_json_mode_resolve ;;
  *) if [[ "$OPT_FOR_AGENT" == "1" || "$OPT_JSONL" == "1" ]]; then fl_json_mode_resolve; fi ;;
esac
# --jsonl and --for-agent: a command that only reads ends with one document that has `exit`
# (a read that has the share family's fields already is only kept back to catch a failure)
FL_READ_KIND=""; FL_READ_MUT=""
if [[ "$OPT_JSON" == "1" && ( "$OPT_JSONL" == "1" || "$OPT_FOR_AGENT" == "1" ) && ( -z "$FL_JSON_MODE" || ( "$FL_JSON_MODE" == "doc" && "$OPT_JSONL" != "1" ) ) && -n "$FL_JSON_KEY" ]]; then
  fl_cmd_attr_v FL_READ_KIND "$FL_JSON_KEY" json
  fl_cmd_attr_v FL_READ_MUT "$FL_JSON_KEY" mutating
  if [[ "$FL_READ_KIND" == "document" && "$FL_READ_MUT" == "no" ]]; then fl_read_env_begin; fi
fi

# fl_app_focus_is_listing ARGS...: "app focus" with no app name lists the
# focus apps (a read), with any of --list, --json, --fetch
fl_app_focus_is_listing() {
  local a
  [[ "$COMMAND" == "app" && "${1:-}" == "focus" ]] || return 1
  shift
  for a in "$@"; do
    case "$a" in -*) ;; *) return 1 ;; esac
  done
  return 0
}

fl_mode_name() {
  if [[ "$FL_DRY_RUN" == "1" ]]; then printf 'dry-run'; else printf '%s' "$COMMAND"; fi
}

fl_cleanup() {
  local code=$?
  # the ERR trap keeps out of the exit trap: set -e alone ends a cleanup that fails
  FL_EXITING=1
  fl_spinner_stop
  # pull closes its SSH connection and ends its JSON stream with "done"
  fl_pull_on_exit "$code"
  # share setup never leaves the scheduler of every site paused, whatever stopped it
  fl_share_on_exit
  # a run cut short between the start and the end of bench's backup puts the kept older backups back
  fl_backups_keep_on_exit
  # a setup Redis started for site add goes, however the command ends
  fl_bench_redis_down >/dev/null 2>&1 || true
  # share preflight's throwaway listener, when a signal ended the run while it was up
  fl_sp_listener_stop
  fl_sudo_end
  fl_lock_release
  # the first run of a fresh install records its version, whatever its exit code (notices.sh)
  fl_notices_on_exit "$code"
  # a doctor run that was cut short leaves its folder of kept answers (facts.sh)
  fl_facts_end
  # the temp logs of a long command, when a signal ended the run
  fl_tmp_cleanup
  # install --json and adopt --json: always the last line, after the lock is free
  fl_jsonl_on_exit "$code"
  # the operation's record is finished once its done line is out, so a reader that sees the run end
  # finds the done line in its output (ops.sh)
  fl_op_end "$code"
  # repair --json: its done line, when the run ended before it could send one
  fl_repair_done "$code"
  # --jsonl and --for-agent on a command that reads: its document, with exit
  fl_read_env_finish "$code"
  [[ -z "${FL_CHANGED_FILE:-}" || "${FL_CHANGED_OWNER:-}" != "$$" ]] || rm -f "$FL_CHANGED_FILE"
}
trap fl_cleanup EXIT
trap 'fl_on_error "$BASH_COMMAND"' ERR
# TERM, INT and HUP reach the running command's whole process group and the
# phase script in the foreground, then the EXIT trap releases the lock
fl_signal_traps_install

# The JSON stream: lib/frappe-local/stream.sh (CORE-18). It is sourced here, where its code used to be,
# and by a lean start too: the exit trap sends the done line.
# shellcheck source=lib/frappe-local/stream.sh
. "${SCRIPT_DIR}/lib/frappe-local/stream.sh"

# The bodies of the commands: lib/frappe-local/cmd-<command>.sh (CORE-18, maintainers/DECISIONS.md). They
# are sourced here, where the functions used to be, so a run that ends before this point (--version,
# --help, a usage error) does not read them. A lean start skips them: no lean command calls one.
# shellcheck source=lib/frappe-local/cmd-doctor.sh
[[ "$FL_LEAN" == "1" ]] || . "${SCRIPT_DIR}/lib/frappe-local/cmd-doctor.sh"
# shellcheck source=lib/frappe-local/cmd-repair.sh
[[ "$FL_LEAN" == "1" ]] || . "${SCRIPT_DIR}/lib/frappe-local/cmd-repair.sh"
# shellcheck source=lib/frappe-local/cmd-service.sh
[[ "$FL_LEAN" == "1" ]] || . "${SCRIPT_DIR}/lib/frappe-local/cmd-service.sh"
# shellcheck source=lib/frappe-local/cmd-adopt.sh
[[ "$FL_LEAN" == "1" ]] || . "${SCRIPT_DIR}/lib/frappe-local/cmd-adopt.sh"
# shellcheck source=lib/frappe-local/cmd-install.sh
[[ "$FL_LEAN" == "1" ]] || . "${SCRIPT_DIR}/lib/frappe-local/cmd-install.sh"

# a version change is recorded (and its notices activated) on every command; a person's command
# prints the notices once, on stderr (notices.sh)
fl_notices_run

# --background: refused here when it cannot run unattended, else started detached; the caller gets the
# op_id at once and the stream goes to the operation's own output (ops.sh)
if [[ "$OPT_BACKGROUND" == "1" ]]; then
  fl_lab_gate "${FL_JSON_KEY:-$COMMAND}"
  # a lease stops it here, with the holder, and not in the detached run the caller would then have to poll
  fl_lease_gate
  [[ "$FL_DRY_RUN" == "1" ]] || fl_noninteractive_preflight
  fl_op_background ${FL_ORIG_ARGS[@]+"${FL_ORIG_ARGS[@]}"}
fi

# the stream starts first, so that a refusal (the preflight) is a done line and not silence:
# install and adopt with --json before the log and the lock (fl_jsonl_start runs the preflight)
if [[ "$OPT_JSON" == "1" && ( "$COMMAND" == "install" || "$COMMAND" == "adopt" ) ]]; then
  fl_jsonl_start
else
  # the other commands that stream (or whose document the stream wraps)
  if [[ "$FL_JSON_MODE" == "stream" || ( "$FL_JSON_MODE" == "doc" && "$OPT_JSONL" == "1" ) ]]; then fl_jsonl_begin_generic; fi
  # the lab gate comes after the stream starts (a stream gets its done line, a --json
  # document its error object) and before the preflight (a lab that is off is exit 2, not
  # a missing input)
  fl_lab_gate "${FL_JSON_KEY:-$COMMAND}"
  # a lease on the bench or the site a changing command covers stops it here, before the missing inputs are
  # asked for, the lock and any change (lease.sh); a dry run and the reads pass
  fl_lease_gate
  fl_noninteractive_preflight
fi

# a command that changes things on a bench it picked on its own says which (and an agent must name one)
# (a guest's share commands act on somebody else's room, on no bench of this computer)
if [[ -z "$OPT_BENCH_DIR" ]] && ! { [[ "$COMMAND" == share ]] && fl_share_guest_sub "${ARGS[0]:-}"; }; then
  case "$COMMAND" in
    install|adopt|register|scan|self-update|labs|profile|ports|lan-guard|docs|report|help|commands|mcp|where|mariadb-password) ;;
    *)
      fl_cmd_attr_v FL_GUESS_MUT "$(fl_cmd_key_for "$COMMAND" "${ARGS[0]:-}" || true)" mutating
      if [[ "$FL_GUESS_MUT" == "yes" && " ${ARGS[*]:-} " != *" --all "* ]]; then fl_bench_guess_gate; fi ;;
  esac
fi

case "$COMMAND" in
  ports)
    if [[ "${ARGS[0]:-}" == apply || "${ARGS[0]:-}" == mode ]]; then
      fl_log_init "${FL_STATE_DIR}/logs"
      fl_lock_acquire "${FL_STATE_DIR}/lock"
    fi ;;
  register|self-update)
    # self-update --check only asks GitHub (one curl of up to 10 s) and writes nothing: no run lock, so a
    # check never holds up an up or a repair, and no run log, so a poll leaves no file behind
    if [[ "$COMMAND" == "self-update" && " ${ARGS[*]:-} " == *" --check "* ]]; then :; else
      fl_log_init "${FL_STATE_DIR}/logs"
      fl_lock_acquire "${FL_STATE_DIR}/lock"
    fi ;;
  # labs on and off write the state file and off may stop a share; list and status read
  labs)
    if [[ "${ARGS[0]:-}" == "on" || "${ARGS[0]:-}" == "off" ]]; then
      fl_log_init "${FL_STATE_DIR}/logs"
      fl_lock_acquire "${FL_STATE_DIR}/lock"
    fi ;;
  # doctor reads; --ack and --unack write the bench's state file, under the lock
  doctor)
    if [[ -n "$OPT_ACK" || -n "$OPT_UNACK" ]]; then
      fl_log_init "${FL_STATE_DIR}/logs"
      fl_lock_acquire "${FL_STATE_DIR}/lock"
    fi ;;
  share)
    # users, preflight, status, people and log read; setup makes the copy and the identity, start the
    # job, teardown drops the copy and the share folder. stop, extend and the room's changes take no lock:
    # a long setup or start must never keep a share from being stopped or a person from being removed.
    # code, invite and open-as never open a run log: they handle the room code and a session id.
    # Neither do the guest's join, leave and forget: join handles the code, and all three act on no bench.
    case "${ARGS[0]:-}" in
      setup|start|teardown)
        fl_log_init "${FL_STATE_DIR}/logs"
        fl_lock_acquire "${FL_STATE_DIR}/lock" ;;
      stop|extend|lock|unlock|remove|revoke|assign) fl_log_init "${FL_STATE_DIR}/logs" ;;
    esac ;;
  lan-guard)
    case "${ARGS[0]:-}" in install|remove|allow-node) fl_log_init "${FL_STATE_DIR}/logs" ;; esac ;;
  # forget, remove, scratch and gc change the list of benches and the state folder (a plan too: it reads under the lock)
  bench)
    fl_log_init "${FL_STATE_DIR}/logs"
    fl_lock_acquire "${FL_STATE_DIR}/lock" ;;
  # run: the allow list decides (refused here with exit 64, before the lock); a run that executes has a
  # log of its own, and one that changes things takes the lock; a plan and a read take none
  run)
    fl_run_prepare
    if [[ "$RUN_EXECUTES" == "1" ]]; then
      fl_log_init "${FL_STATE_DIR}/logs"
      [[ "$RUN_CHANGES" != "yes" ]] || fl_lock_acquire "${FL_STATE_DIR}/lock"
    fi ;;
  site|app|profile|lock)
    # the list, show and check commands are read only, and so is a --plan
    # and "app focus" without an app name (the focus listing, with or
    # without --fetch: its one write, FETCHED_AT, goes through the key-value
    # file's own lock); the others change things
    if [[ "${ARGS[0]:-list}" != "list" && "${ARGS[0]:-}" != "show" && "${ARGS[0]:-}" != "check" && "${ARGS[0]:-}" != "backups" && "${ARGS[0]:-}" != "snapshots" \
      && " ${ARGS[*]:-} " != *" --plan "* && ! ( "${ARGS[0]:-}" == "open-as" && "${ARGS[1]:-}" == "status" ) ]] && ! fl_app_focus_is_listing "${ARGS[@]+"${ARGS[@]}"}"; then
      fl_log_init "${FL_STATE_DIR}/logs"
      fl_lock_acquire "${FL_STATE_DIR}/lock"
    fi
    ;;
  # fg stops the background bench first (a down), so it holds the lock until
  # just before it execs honcho (fl_cmd_fg releases it there)
  install|adopt|service|repair|up|down|restart|autostart|listen|uninstall-service|pull|fg)
    [[ "$FL_JSONL_KIND" == "own" ]] || fl_log_init "${FL_STATE_DIR}/logs"
    fl_lock_acquire "${FL_STATE_DIR}/lock"
    ;;
  *) ;;
esac

# a detached run (--background) says "running" now: it holds the lock, so it was not refused (ops.sh)
fl_op_running

# BENCHBAR_SUDO=env: the sudo password is checked once, before anything changes
# (repair does it in cmd_repair, once its events have started)
case "$COMMAND ${ARGS[0]:-}" in
  "install "*|"adopt "*|"service "*|"site add"|"ports apply") fl_sudo_env_preflight ;;
esac
# site add and ports apply run no sudo step on Linux (no /etc/hosts line): the checked password is not kept
case "$COMMAND ${ARGS[0]:-}" in
  "site add"|"ports apply") fl_sudo_phase_done ;;
esac

case "$COMMAND" in
  # exit by hand: install's own codes (2 the password, 1 a cancel) must not
  # pass through the ERR trap, which maps an incidental 2 to 1
  install) cmd_install || exit $? ;;
  adopt) cmd_adopt "${ARGS[0]:-}" ;;
  service) cmd_service ;;
  mariadb-password) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_mariadb_password ;;
  # exit 1 by hand: a failing check must not reach the ERR trap, whose
  # "[FAIL] Last command failed" line would follow the JSON on stdout
  doctor) cmd_doctor || exit 1 ;;
  repair) cmd_repair || exit $? ;;
  status) cmd_status ;;
  stats) FL_CONTEXT_LIGHT=1; fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_stats ;;
  list) FL_CONTEXT_LIGHT=1; fl_cmd_list "$OPT_JSON" ;;
  ports)
    [[ "${ARGS[0]:-}" == check ]] && FL_CONTEXT_LIGHT=1
    fl_cmd_ports ${ARGS[@]+"${ARGS[@]}"} || exit $? ;;
  scan) fl_cmd_scan "${ARGS[0]:-}" ;;
  register) fl_cmd_register ${ARGS[@]+"${ARGS[@]}"} ;;
  up) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_up ${ARGS[@]+"${ARGS[@]}"} ;;
  down) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_down ;;
  restart) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_restart ;;
  # exit 1 by hand (not ready in time): no ERR trap line after the document
  wait) FL_CONTEXT_LIGHT=1; fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_wait ${ARGS[@]+"${ARGS[@]}"} || exit 1 ;;
  logs) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_logs ${ARGS[@]+"${ARGS[@]}"} ;;
  fg) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_fg ;;
  watch) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_watch ;;
  autostart) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_autostart "${ARGS[0]:-}" ;;
  listen) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_listen "${ARGS[0]:-}" ;;
  uninstall-service)
    if [[ " ${ARGS[*]:-} " == *" --all "* ]]; then
      [[ -z "$OPT_BENCH_DIR" ]] || fl_die "uninstall-service takes --all or --bench-dir, not both." "Every bench: benchbar uninstall-service --all. One bench: benchbar uninstall-service --bench-dir PATH."
      fl_cmd_uninstall_service_all
    else
      fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_uninstall_service
    fi ;;
  # path only names the folder (benchcd runs it): no site, ports, profile or rendered templates
  # (--profile still checks the name: the full context, and a full load)
  path)
    if [[ -n "$OPT_PROFILE" ]]; then fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; else fl_bench_detect "$OPT_BENCH_DIR"; fi
    printf '%s\n' "$FL_BENCH_DIR" ;;
  console) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_console ${ARGS[@]+"${ARGS[@]}"} ;;
  run) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_run || exit $? ;;
  open) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_open ${ARGS[@]+"${ARGS[@]}"} ;;
  users) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_users ${ARGS[@]+"${ARGS[@]}"} ;;
  share) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_share ${ARGS[@]+"${ARGS[@]}"} ;;
  lan-guard) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_lan_guard ${ARGS[@]+"${ARGS[@]}"} ;;
  db) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_db ${ARGS[@]+"${ARGS[@]}"} ;;
  bench)
    # forget and remove name the bench by PATH, the others work on every known bench (gc) or on PATH (scratch)
    case "${ARGS[0]:-}" in
      forget|remove|scratch)
        # PATH may come after --apply TOKEN: the same parse as the command's own finds it
        fl_lc_parse "${ARGS[@]:1}"
        if [[ -n "$LC_PATH" ]]; then OPT_BENCH_DIR="$LC_PATH"; fi
        fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE" ;;
    esac
    fl_cmd_bench ${ARGS[@]+"${ARGS[@]}"} ;;
  site) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_site ${ARGS[@]+"${ARGS[@]}"} ;;
  app) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_app ${ARGS[@]+"${ARGS[@]}"} ;;
  profile) fl_cmd_profile ${ARGS[@]+"${ARGS[@]}"} ;;
  # status exits 1 for a lab that is off, without the ERR trap's line
  labs) FL_DONE_NO_BENCH=1; fl_cmd_labs ${ARGS[@]+"${ARGS[@]}"} || exit $? ;;
  # leases are benchbar's own state, under a lock of their own: no run lock, no bench context
  lease) fl_cmd_lease ${ARGS[@]+"${ARGS[@]}"} ;;
  notices) FL_DONE_NO_BENCH=1; fl_cmd_notices ${ARGS[@]+"${ARGS[@]}"} ;;
  # like doctor: drift exits 1 without the ERR trap's line after the JSON
  lock) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_lock ${ARGS[@]+"${ARGS[@]}"} || exit 1 ;;
  pull) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_pull ${ARGS[@]+"${ARGS[@]}"} ;;
  report) fl_context_init "$OPT_BENCH_DIR" "$OPT_SITE" "$OPT_PROFILE"; fl_cmd_report ${ARGS[@]+"${ARGS[@]}"} ;;
  docs) fl_cmd_docs ${ARGS[@]+"${ARGS[@]}"} ;;
  self-update) fl_cmd_self_update ${ARGS[@]+"${ARGS[@]}"} || exit 1 ;;
  where) cmd_where ;;
  commands) if [[ "$OPT_JSON" == "1" ]]; then fl_commands_json; else fl_cmd_visible_table | awk -F'~' '$1 == "cmd" { printf "%-22s %s\n", $2, $4 }'; fi ;;
  mcp) cmd_mcp ;;
  # a run that is not done is exit 1 without the ERR trap's line, like doctor
  op) fl_cmd_op ${ARGS[@]+"${ARGS[@]}"} || exit 1 ;;
  history) fl_cmd_history ${ARGS[@]+"${ARGS[@]}"} ;;
  help) usage ;;
  *) fl_die "Unknown command: ${COMMAND}" "Run: benchbar --help" ;;
esac
