#!/usr/bin/env bash
# env/bin/python of a fake bench. Besides the version it answers benchbar's
# stdin secret wrapper for frappe commands:
#   -c SNIPPET benchbar-secrets frappe new-site|drop-site SITE ARGS...
# The secrets arrive on stdin and are saved to $MOCK_STATE/stdin-new-site,
# never logged; the call is logged as "bench new-site SITE ARGS" with the
# @secretN@ placeholders, so tests can assert both. Runs in sites/, like frappe.
case "$*" in
  *version_info*) echo "3.11"; exit 0 ;;
  --version) echo "Python 3.11.9"; exit 0 ;;
  # MOCK_ENV_NO_PKG_RESOURCES=1: an env whose setuptools is 70+ or absent
  "-c import pkg_resources") [[ "${MOCK_ENV_NO_PKG_RESOURCES:-0}" == "1" ]] && { echo "ModuleNotFoundError: No module named 'pkg_resources'" >&2; exit 1; }; exit 0 ;;
  "-m pip "*) printf 'env-python %s\n' "$*" >>"${MOCK_LOG:-/dev/null}"; exit 0 ;;
esac
if [[ "${1:-}" == "-c" && "${3:-}" == "benchbar-secrets" && "${4:-}" == "frappe" ]]; then
  shift 4
  cmd="${1:-}"
  cat >"${MOCK_STATE:?}/stdin-${cmd}"
  printf 'bench %s\n' "$*" >>"${MOCK_LOG:-/dev/null}"
  case "$cmd" in
    new-site)
      [[ -n "${MOCK_BENCH_NEW_SITE_EXIT:-}" ]] && exit "$MOCK_BENCH_NEW_SITE_EXIT"
      site="$2"
      mkdir -p "$site"; touch "$site/installed_apps"; printf '{"db_name": "_x"}\n' >"$site/site_config.json" ;;
    drop-site)
      # like frappe: a backup with files (no config), then the folder to ../archived/sites
      [[ -n "${MOCK_DROP_SITE_EXIT:-}" ]] && { echo "Error: backup failed" >&2; exit "$MOCK_DROP_SITE_EXIT"; }
      site="$2"
      base="${site}/private/backups/20260929_110000-${site//./_}"
      mkdir -p "${site}/private/backups"
      printf 'dump\n' >"${base}-database.sql.gz"; printf 'public\n' >"${base}-files.tar"; printf 'private\n' >"${base}-private-files.tar"
      mkdir -p ../archived/sites
      dest="../archived/sites/${site}"; n=""
      while [[ -e "${dest}${n}" ]]; do n=$(( ${n:-0} + 1 )); done
      mv "$site" "${dest}${n}" ;;
  esac
  exit 0
fi
# benchbar's own helpers for open --as and users:
#   -c SNIPPET benchbar-open-as SITE USER
#   -c SNIPPET benchbar-users SITE QUERY LIMIT MODE
# Users come from $MOCK_STATE/users.json (Administrator alone without it);
# MOCK_OPEN_AS_REFUSE fails the login with that text; MOCK_OPEN_AS_SID is the
# session id. Each argument is logged in brackets, so a test sees how argv arrived.
if [[ "${1:-}" == "-c" && ( "${3:-}" == "benchbar-open-as" || "${3:-}" == "benchbar-users" ) ]]; then
  marker="$3"; shift 3
  { printf 'bench-python %s' "$marker"; for a in "$@"; do printf ' [%s]' "$a"; done; printf '\n'; } >>"${MOCK_LOG:-/dev/null}"
  exec python3 - "$marker" "$@" <<'PY'
import json, os, sys
marker, args = sys.argv[1], sys.argv[2:]
print("UserWarning: frappe prints noise like this", file=sys.stderr)
try:
    users = json.load(open(os.path.join(os.environ["MOCK_STATE"], "users.json")))
except FileNotFoundError:
    users = [{"name": "Administrator", "full_name": "Administrator", "user_type": "System User", "enabled": 1,
              "roles": ["System Manager"], "last_login": None}]
if marker == "benchbar-open-as":
    site, user = args
    if os.environ.get("MOCK_OPEN_AS_REFUSE"):
        print("BENCHBAR-ERROR " + os.environ["MOCK_OPEN_AS_REFUSE"])
        sys.exit(1)
    u = next((x for x in users if x["name"] == user), None)
    if not u:
        print("BENCHBAR-ERROR No user %r on %s." % (user, site))
        sys.exit(1)
    if not u.get("enabled", 1):
        print("BENCHBAR-ERROR %s is disabled on %s." % (user, site))
        sys.exit(1)
    print("BENCHBAR-RESULT " + "\t".join([u["name"], u["full_name"], u["user_type"], os.environ.get("MOCK_OPEN_AS_SID", "mocksid0123456789")]))
    sys.exit(0)
site, query, limit, mode = args[0], args[1].lower(), int(args[2]), args[3]
rows = [u for u in users if u.get("enabled", 1) and u["name"] != "Guest"
        and (not query or query in u["name"].lower() or query in u["full_name"].lower())]
rows.sort(key=lambda u: (u["user_type"], u["name"]))
more, rows = len(rows) > limit, rows[:limit]
out = [{"name": u["name"], "full_name": u["full_name"], "user_type": u["user_type"], "roles": u.get("roles", [])[:5],
        "role_count": len(u.get("roles", [])), "last_login": u.get("last_login")} for u in rows]
if mode == "json":
    print("BENCHBAR-RESULT " + json.dumps({"users": out, "truncated": more}))
else:
    print("BENCHBAR-RESULT " + ("1" if more else "0"))
    for u in out:
        print("BENCHBAR-RESULT " + "\t".join([u["name"], u["full_name"], u["user_type"], ", ".join(u["roles"])]))
PY
fi
exit 0
