#!/usr/bin/env bash
# honcho mock: self-contained because it gets copied into fake venvs
printf 'honcho %s\n' "$*" >>"${MOCK_LOG:-/dev/null}"
# MOCK_HONCHO_SLEEP keeps it alive for a while, like a running bench;
# MOCK_HONCHO_PIDFILE records its pid so a test can signal it
[[ -n "${MOCK_HONCHO_PIDFILE:-}" ]] && printf '%s\n' "$$" >"$MOCK_HONCHO_PIDFILE"
if [[ -n "${MOCK_HONCHO_SLEEP:-}" ]]; then
  trap 'exit "${MOCK_HONCHO_TERM_EXIT:-0}"' TERM
  sleep "$MOCK_HONCHO_SLEEP" &
  wait $!
fi
exit "${MOCK_HONCHO_EXIT:-0}"
