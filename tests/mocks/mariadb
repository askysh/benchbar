#!/usr/bin/env bash
# mariadb client mock (copied into the fake brew prefix).
# The root password lives in $MOCK_STATE/mariadb_root_pw (absent: no password,
# like a fresh Homebrew install). Logins use MYSQL_PWD, like the CLI.
# SQL on stdin is recorded in $MOCK_STATE/mariadb_sql.log; an ALTER USER
# statement sets the password.
# MOCK_MARIADB_ROOT_SOCKET_ONLY=1: a fresh Homebrew MariaDB 10.4+, where root
# has unix_socket authentication (a TCP login as root is refused with 1698)
# and the macOS user ($USER) has a socket account with full privileges; once
# ALTER USER gives root a native password, root logs in with it as usual.
# In that mode a command run through the sudo mock (MOCK_AS_ROOT=1, the OS root
# user) logs in as root over the socket with no password, like Ubuntu's.
printf 'mariadb %s\n' "$*" >>"${MOCK_LOG:-/dev/null}"
state="${MOCK_STATE:-/nonexistent}"
pwfile="$state/mariadb_root_pw"
user="root"; prev=""
for a in "$@"; do [[ "$prev" == "-u" ]] && user="$a"; prev="$a"; done
check_login() {
  local want=""
  # Ubuntu's root is unix_socket: the OS root user (a command run through the
  # sudo mock) logs in over the socket whatever the password is
  if [[ "${MOCK_MARIADB_ROOT_SOCKET_ONLY:-0}" == "1" && "${MOCK_AS_ROOT:-0}" == "1" && "$user" == "root" ]]; then return 0; fi
  if [[ "$user" != "root" ]]; then
    # only the OS user's socket account exists, only in socket mode, only without a password
    [[ "${MOCK_MARIADB_ROOT_SOCKET_ONLY:-0}" == "1" && "$user" == "${FL_OS_USER:-${USER:-}}" && -z "${MYSQL_PWD:-}" ]] || return 1
    # MOCK_MARIADB_USER_NO_GRANTS=1: that account may run SELECT 1 and nothing else
    if [[ "${MOCK_MARIADB_USER_NO_GRANTS:-0}" == "1" ]]; then
      case "$*" in *"SELECT 1"*) return 0 ;; *) echo "ERROR 1142 (42000): SELECT command denied to user '${user}'@'localhost'" >&2; return 1 ;; esac
    fi
    return 0
  fi
  if [[ ! -f "$pwfile" && "${MOCK_MARIADB_ROOT_SOCKET_ONLY:-0}" == "1" ]]; then
    echo "ERROR 1698 (28000): Access denied for user 'root'@'localhost'" >&2
    return 1
  fi
  [[ -f "$pwfile" ]] && want="$(cat "$pwfile")"
  [[ "${MYSQL_PWD:-}" == "$want" ]]
}
case "$*" in
  --version) printf 'mariadb  Ver 15.1 Distrib 10.11.14-MariaDB, for osx10.20 (arm64)\n'; exit 0 ;;
esac
case "$*" in
  *"-e "*|*"-sNe "*)
    check_login || { echo "ERROR 1045 (28000): Access denied for user '${user}'@'localhost' (using password: $([[ -n "${MYSQL_PWD:-}" ]] && echo YES || echo NO))" >&2; exit 1; }
    case "$*" in
      *"character_set_server"*) printf 'character_set_server\tutf8mb4\n' ;;
      # root's native hash: 'invalid' until ALTER USER gave it a password
      *"SELECT authentication_string FROM mysql.user"*) if [[ -f "$pwfile" ]]; then printf '*%s\n' "$(printf '%s' "$(cat "$pwfile")" | shasum -a 1 | tr 'a-f' 'A-F' | cut -c1-40)"; else printf 'invalid\n'; fi ;;
    esac
    exit 0 ;;
  *)
    # SQL script on stdin
    check_login || { echo "ERROR 1045 (28000): Access denied for user '${user}'@'localhost'" >&2; exit 1; }
    sql="$(cat)"
    printf '%s\n' "$sql" >>"$state/mariadb_sql.log"
    newpw="$(printf '%s\n' "$sql" | sed -n "s/.*ALTER USER 'root'@'localhost' IDENTIFIED VIA \(unix_socket OR \)\{0,1\}mysql_native_password USING PASSWORD('\([^']*\)').*/\2/p" | head -n1)"
    [[ -n "$newpw" ]] && printf '%s' "$newpw" >"$pwfile"
    exit 0 ;;
esac
