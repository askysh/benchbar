#!/usr/bin/env bash
# osascript stand-in for BENCHBAR_SUDO=gui tests (FL_OSASCRIPT points at it).
# benchbar calls: osascript -e ... -e ... -e ... -- COMMANDLINE REASON. This
# one records the REASON of every call in $MOCK_STATE/osa_reasons and the
# COMMANDLINE of call N in $MOCK_STATE/osa_cmd.N, then, like "do shell
# script", runs the command line with /bin/sh, as the test user and not as
# root, with the absolute tool paths of the root scripts mapped to the mocks:
#   $MOCK_STATE/osa_cancel_all   every dialog is cancelled
#   $MOCK_STATE/osa_cancel       cancels the dialogs whose REASON is a line of this file
#   $MOCK_STATE/osa_fail         every command fails
state="${MOCK_STATE:?}"
cmd="${*:$(($# - 1)):1}"
reason="${*:$#:1}"
printf '%s\n' "$reason" >>"$state/osa_reasons"
n="$(wc -l <"$state/osa_reasons" | tr -d ' ')"
printf '%s' "$cmd" >"$state/osa_cmd.$n"
if [[ -f "$state/osa_cancel_all" ]] || { [[ -f "$state/osa_cancel" ]] && grep -qxF -- "$reason" "$state/osa_cancel"; }; then
  echo "execution error: User canceled. (-128)" >&2
  exit 1
fi
if [[ -f "$state/osa_fail" ]]; then echo "execution error: the script failed (1)" >&2; exit 1; fi
mapped="$(printf '%s' "$cmd" | sed -e 's#/usr/bin/install #install #g' -e 's#/usr/bin/mktemp#mktemp#g' -e 's#/usr/bin/shasum#shasum#g' \
  -e 's#/usr/bin/awk#awk#g' -e 's#/usr/sbin/installer#installer#g' -e 's#/usr/sbin/softwareupdate#softwareupdate#g')"
exec /bin/sh -c "$mapped"
