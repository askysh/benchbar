#!/usr/bin/env bash
# ditto mock: "-x -k ZIP DIR" unzips, "-c -k --keepParent SRC ZIP" zips, "SRC DST" copies
# shellcheck source=tests/mocks/bin/_mocklib.sh
. "$(dirname "$0")/_mocklib.sh"
mock_log "$@"
case "${1:-}" in
  -x) shift; [[ "${1:-}" == "-k" ]] && shift; mkdir -p "$2"; unzip -q -o "$1" -d "$2" ;;
  -c) shift; [[ "${1:-}" == "-k" ]] && shift; [[ "${1:-}" == "--keepParent" ]] && shift; (cd "$(dirname "$1")" && zip -q -r "$2" "$(basename "$1")") ;;
  *) rm -rf "$2"; cp -R "$1" "$2" ;;
esac
