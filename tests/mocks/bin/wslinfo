#!/bin/bash
# wslinfo mock: `--networking-mode` prints $MOCK_WSL_NETMODE (default mirrored, so a test of something else
# on WSL is not stopped by NAT); anything else is only logged
# shellcheck source=tests/mocks/bin/_mocklib.sh
. "${0%/*}/_mocklib.sh"
mock_log "$@"
case "${1:-}" in
  --networking-mode) printf '%s\n' "${MOCK_WSL_NETMODE:-mirrored}" ;;
  *) ;;
esac
exit 0
