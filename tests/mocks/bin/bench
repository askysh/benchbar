#!/usr/bin/env bash
# bench mock: enough of the bench CLI for the installer and repair flows.
# shellcheck source=tests/mocks/bin/_mocklib.sh
. "$(dirname "$0")/_mocklib.sh"
mock_log "$@"
[[ -n "${BENCH_LOG:-}" ]] && printf 'bench %s\n' "$*" >>"$BENCH_LOG"
case "$1" in
  version) printf 'erpnext 15.0.0\nfrappe 15.0.0\n'; exit 0 ;;
  init)
    mkdir -p "$2/apps/frappe" "$2/env/bin" "$2/sites" "$2/config"
    cp "$(dirname "$0")/../env-python" "$2/env/bin/python"; chmod +x "$2/env/bin/python"
    printf 'port 11000\n' >"$2/config/redis_queue.conf"; printf 'port 13000\n' >"$2/config/redis_cache.conf"
    touch "$2/sites/apps.txt"; exit 0 ;;
  --version) [[ -n "${MOCK_BENCH_VERSION:-}" ]] && printf '%s\n' "$MOCK_BENCH_VERSION"; exit 0 ;;
  get-app)
    app="${*: -1}"; app="${app##*/}"; app="${app%.git}"
    if [[ "${MOCK_GIT_REAL:-0}" == "1" ]]; then
      # like bench: clone with --origin upstream (shallow when asked), apps.txt
      shift; branch=""; repo=""
      while [[ "$#" -gt 0 ]]; do
        case "$1" in --branch) branch="$2"; shift 2 ;; -*) shift ;; *) repo="$1"; shift ;; esac
      done
      app="$(printf '%s' "$app" | tr '[:upper:]-' '[:lower:]_')"
      depth=(); [[ "${MOCK_BENCH_SHALLOW:-0}" == "1" ]] && depth=(--depth 1)
      git clone -q --origin upstream ${depth[@]+"${depth[@]}"} ${branch:+--branch "$branch"} "$repo" "apps/$app" || exit 1
      [[ -n "$(tail -c1 sites/apps.txt 2>/dev/null)" ]] && printf '\n' >>sites/apps.txt
      printf '%s\n' "$app" >>sites/apps.txt
      [[ -n "${MOCK_BENCH_GET_APP_EXIT:-}" ]] && exit "$MOCK_BENCH_GET_APP_EXIT"
      exit 0
    fi
    mkdir -p "apps/$app"; exit 0 ;;
  new-site)
    [[ -n "${MOCK_BENCH_NEW_SITE_EXIT:-}" ]] && exit "$MOCK_BENCH_NEW_SITE_EXIT"
    mkdir -p "sites/$2"; touch "sites/$2/installed_apps"; printf '{"db_name": "_x"}\n' >"sites/$2/site_config.json"; exit 0 ;;
  use) printf '%s\n' "$2" >sites/currentsite.txt; exit 0 ;;
  set-config)
    # set-config -g [-p] KEY VALUE: writes sites/common_site_config.json like frappe
    shift; parse=0
    while [[ "${1:-}" == -* ]]; do [[ "$1" == "-p" ]] && parse=1; shift; done
    python3 - "$1" "$2" "$parse" <<'PY'
import json, sys
key, value, parse = sys.argv[1], sys.argv[2], sys.argv[3] == "1"
path = "sites/common_site_config.json"
conf = json.load(open(path))
conf[key] = int(value) if parse else value
json.dump(conf, open(path, "w"), indent=1, sort_keys=True)
open(path, "a").write("\n")
PY
    exit 0 ;;
  build)
    # create every dist file referenced by assets.json
    if [[ -f sites/assets/assets.json ]]; then
      grep -o '"/assets/[^"]*"' sites/assets/assets.json | tr -d '"' | while read -r ref; do
        f="sites/assets/${ref#/assets/}"; mkdir -p "$(dirname "$f")"; printf 'built\n' >"$f"
      done
    fi
    exit "${MOCK_BENCH_BUILD_EXIT:-0}" ;;
  setup)
    case "$2" in
      env)
        mkdir -p env/bin
        cat >env/bin/python <<'PY'
#!/bin/bash
case "$*" in *version_info*) echo "3.11" ;; --version) echo "Python 3.11.9" ;; *) exit 0 ;; esac
PY
        chmod +x env/bin/python; exit 0 ;;
      redis)
        mkdir -p config
        for k in redis_queue redis_cache; do
          port="$(sed -n "s/.*\"${k}\": \"redis:\/\/127.0.0.1:\([0-9]*\)\".*/\1/p" sites/common_site_config.json)"
          printf 'port %s\n' "$port" >"config/${k}.conf"
        done
        exit 0 ;;
      requirements)
        case "$3" in
          --node) mkdir -p apps/frappe/node_modules/socket.io; exit 0 ;;
          *) exit 0 ;;
        esac ;;
    esac
    exit 0 ;;
  --site)
    case "$3" in
      list-apps)
        [[ -n "${MOCK_BENCH_LIST_APPS_EXIT:-}" ]] && exit "$MOCK_BENCH_LIST_APPS_EXIT"
        if [[ "${4:-}" == "--format" && "${5:-}" == "json" ]]; then
          printf '{"%s": [' "$2"; sep=""
          if [[ -f "sites/$2/installed_apps" ]]; then
            while read -r a _; do [[ -n "$a" ]] && { printf '%s"%s"' "$sep" "$a"; sep=", "; }; done <"sites/$2/installed_apps"
          fi
          printf ']}\n'; exit 0
        fi
        [[ -f "sites/$2/installed_apps" ]] && cat "sites/$2/installed_apps"; exit 0 ;;
      install-app)
        [[ -n "${MOCK_BENCH_INSTALL_APP_EXIT:-}" ]] && exit "$MOCK_BENCH_INSTALL_APP_EXIT"
        mkdir -p "sites/$2"; printf '%s 1.0.0\n' "$4" >>"sites/$2/installed_apps"; exit 0 ;;
      migrate) exit "${MOCK_BENCH_MIGRATE_EXIT:-0}" ;;
      doctor|clear-cache|clear-website-cache) exit 0 ;;
      disable-scheduler) exit 0 ;;
      set-config)
        # bench --site S set-config [-p] KEY VALUE: the site's own config
        site="$2"; shift 3; parse=0
        [[ "${1:-}" == "-p" ]] && { parse=1; shift; }
        python3 - "sites/${site}/site_config.json" "$1" "$2" "$parse" <<'PY'
import json, sys
path, key, value, parse = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4] == "1"
conf = json.load(open(path))
conf[key] = json.loads(value) if parse else value
json.dump(conf, open(path, "w"), indent=1, sort_keys=True)
open(path, "a").write("\n")
PY
        exit 0 ;;
      remove-from-installed-apps)
        grep -v "^$4 " "sites/$2/installed_apps" >"sites/$2/installed_apps.tmp" || true
        mv "sites/$2/installed_apps.tmp" "sites/$2/installed_apps"; exit 0 ;;
      backup)
        mkdir -p "sites/$2/private/backups"; printf 'local backup\n' >"sites/$2/private/backups/local-$(date +%s)-database.sql.gz"; exit 0 ;;
    esac
    exit 0 ;;
  *) exit 0 ;;
esac
