#!/usr/bin/env bash
# installer mock: "installs" the wkhtmltopdf package by recording it
# shellcheck source=tests/mocks/bin/_mocklib.sh
. "$(dirname "$0")/_mocklib.sh"
mock_log "$@"
pkg=""
while [[ "$#" -gt 0 ]]; do case "$1" in -pkg) pkg="$2"; shift 2 ;; *) shift ;; esac; done
[[ -f "$pkg" ]] || { echo "installer: Error - the package path specified was invalid: '$pkg'." >&2; exit 1; }
case "$pkg" in *wkhtmltox*) printf 'installed\n' >"${MOCK_STATE:?}/wkhtml_installed" ;; esac
printf 'installer: The install was successful.\n'
exit 0
