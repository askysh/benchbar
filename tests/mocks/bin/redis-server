#!/usr/bin/env bash
# redis-server mock: "--version", or "config/<x>.conf --daemonize yes" adds a
# fake listener on the port from that file. MOCK_REDIS_PROC=1 also puts the
# server in the fake process table with the working folder it was started
# in, as a real one is, so benchbar's own-process test finds it and a kill
# drops it (the listener goes with it).
# shellcheck source=tests/mocks/bin/_mocklib.sh
. "$(dirname "$0")/_mocklib.sh"
[[ "${1:-}" == "--version" ]] && { printf 'Redis server v=7.2.5 sha=00000000:0 malloc=libc bits=64 build=abc\n'; exit 0; }
mock_log "$@"
if [[ -f "${1:-}" && " $* " == *" --daemonize yes "* ]]; then
  port="$(awk '$1 == "port" {print $2; exit}' "$1")"
  pid="$((RANDOM + 20000))"
  # MOCK_REDIS_NOLISTEN=1: a server that starts and never listens
  [[ -n "$port" && -z "${MOCK_REDIS_NOLISTEN:-}" ]] && printf '%s %s redis-server 127.0.0.1\n' "$port" "$pid" >>"${MOCK_LISTEN:?}"
  if [[ -n "${MOCK_REDIS_PROC:-}" && -n "$port" ]]; then
    printf '%s redis-server %s\n' "$pid" "$1" >>"${MOCK_PROCS:?}"
    printf '%s redis-server %s\n' "$pid" "$1" >>"${MOCK_STATE:?}/ever_procs"
    mkdir -p "${MOCK_STATE}/cwd" "${MOCK_STATE}/proc/${pid}"
    printf '%s' "$PWD" >"${MOCK_STATE}/cwd/${pid}"
    ln -sfn "$PWD" "${MOCK_STATE}/proc/${pid}/cwd"
  fi
fi
exit 0
