#!/usr/bin/env bash
# git mock for install.sh: "clone URL DIR" copies the checkout at $MOCK_REPO_ROOT
# into DIR (with a fake .git), "pull --ff-only" reports "Already up to date."
# unless $MOCK_STATE/git_update exists, "rev-parse --short HEAD" prints the
# content of $MOCK_STATE/git_head (default abc1234). Anything else: real git.
# shellcheck source=tests/mocks/bin/_mocklib.sh
. "$(dirname "$0")/_mocklib.sh"
mock_log "$@"
dir=""
if [[ "${1:-}" == "-C" ]]; then dir="$2"; shift 2; fi
# MOCK_GIT_REAL=1: every call goes to the real git (the app and lock tests
# use real repos with file:// remotes). MOCK_GIT_LSREMOTE_EXIT fakes a
# remote that cannot be read (a private repo without a key or token).
if [[ "${1:-}" == "ls-remote" && -n "${MOCK_GIT_LSREMOTE_EXIT:-}" ]]; then
  printf 'git@github.com: Permission denied (publickey).\nfatal: Could not read from remote repository.\n' >&2
  exit "$MOCK_GIT_LSREMOTE_EXIT"
fi
[[ "${MOCK_GIT_REAL:-0}" == "1" ]] && set -- __real__ "$@"
case "${1:-}" in
  __real__) shift ;;
  clone)
    dest="${*: -1}"
    mkdir -p "$dest/.git"
    for f in benchbar frappe-mac lib templates config docs tests; do cp -R "${MOCK_REPO_ROOT:?}/$f" "$dest/"; done
    exit 0 ;;
  pull)
    if [[ -f "${MOCK_STATE:?}/git_update" ]]; then
      printf 'Updating abc1234..def5678\nFast-forward\n'
      printf 'def5678' >"${MOCK_STATE}/git_head"
      rm -f "${MOCK_STATE}/git_update"
    else
      printf 'Already up to date.\n'
    fi
    exit 0 ;;
  rev-parse)
    cat "${MOCK_STATE:?}/git_head" 2>/dev/null || printf 'abc1234'
    printf '\n'
    exit 0 ;;
esac
# Anything else goes to the real git: the first one on PATH outside the
# mocks folder. Never this script again (bash 3.2's "command -v -p" still
# returned the mock, and the exec loop spun forever on macOS).
self="$(cd "$(dirname "$0")" && pwd)/git"
real=""
for cand in $(type -ap git 2>/dev/null) /usr/bin/git /opt/homebrew/bin/git /usr/local/bin/git; do
  [[ -x "$cand" && "$cand" != "$self" && "$cand" != */tests/mocks/bin/git ]] || continue
  real="$cand"; break
done
[[ -n "$real" ]] || { echo "git mock: no real git found" >&2; exit 1; }
if [[ -n "$dir" ]]; then exec "$real" -C "$dir" "$@"; else exec "$real" "$@"; fi
