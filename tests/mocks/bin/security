#!/usr/bin/env bash
# security mock: generic passwords live as files in $MOCK_STATE/keychain/<service>--<account>.
# "security -i" reads one command per line from stdin, split like the real
# parser: on blanks, with double quotes grouping and backslash escaping the
# next character. The add command's words (password hidden) are kept in
# <item>.cmd so a test can check the item's options.
# shellcheck source=tests/mocks/bin/_mocklib.sh
. "$(dirname "$0")/_mocklib.sh"
mock_log "$@"
if [[ "${1:-}" == "-i" ]]; then
  # the words of the first command line on stdin become the arguments
  IFS= read -r line || line=""
  words=(); word=""; inword=0; quoted=0; esc=0
  while IFS= read -r -n1 ch; do
    if [[ "$esc" == "1" ]]; then word="${word}${ch}"; esc=0; continue; fi
    if [[ "$ch" == "\\" ]]; then esc=1; inword=1; continue; fi
    if [[ "$ch" == '"' ]]; then quoted=$((1 - quoted)); inword=1; continue; fi
    if [[ "$quoted" == "0" && ( "$ch" == " " || "$ch" == $'\t' ) ]]; then
      [[ "$inword" == "1" ]] && words+=("$word"); word=""; inword=0; continue
    fi
    word="${word}${ch}"; inword=1
  done < <(printf '%s' "$line")
  [[ "$inword" == "1" ]] && words+=("$word")
  set -- ${words[@]+"${words[@]}"}
fi
# never log the password itself
args=()
skip=0
for a in "$@"; do
  if [[ "$skip" == "1" ]]; then args+=("<hidden>"); skip=0; continue; fi
  [[ "$a" == "-w" ]] && skip=1
  args+=("$a")
done
dir="${MOCK_STATE:?}/keychain"; mkdir -p "$dir"
cmd="${1:-}"; shift || true
service=""; account=""; pw=""; want_pw=0
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -s) service="$2"; shift 2 ;;
    -a) account="$2"; shift 2 ;;
    -w) if [[ -n "${2:-}" && "${2:0:1}" != "-" ]]; then pw="$2"; shift 2; else want_pw=1; shift; fi ;;
    -l|-j) shift 2 ;;
    *) shift ;;
  esac
done
item="$dir/${service}--${account}"
case "$cmd" in
  find-generic-password)
    [[ -f "$item" ]] || { echo "security: SecKeychainSearchCopyNext: The specified item could not be found in the keychain." >&2; exit 44; }
    [[ "$want_pw" == "1" ]] && cat "$item"
    exit 0 ;;
  add-generic-password)
    # $MOCK_STATE/keychain_locked: the login Keychain refuses writes (errSecInteractionNotAllowed)
    [[ -f "${MOCK_STATE}/keychain_locked" ]] && { echo "security: SecKeychainItemCreateFromContent: User interaction is not allowed." >&2; exit 36; }
    printf '%s\n' "$pw" >"$item"; printf '%s \n' "${args[*]}" >"$item.cmd"; exit 0 ;;
  delete-generic-password)
    rm -f "$item"; exit 0 ;;
  *) exit 0 ;;
esac
