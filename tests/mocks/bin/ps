#!/bin/bash
# ps mock: "ps -o command= -p PID" answers from $MOCK_STATE/ps/PID when a test
# recorded one; "ps -o ppid=,comm= -p PID" (fl_person_env_ok's walk up the
# parents) answers from $MOCK_STATE/pstree/PID, one line "PPID COMM", and
# exits 1 for a pid that has no file there (no such process); everything else
# goes to the real ps, except a "-p PID" for a pid the test made up (add_proc, a redis-server
# mock): such a pid is no process, whatever the machine running the suite has under that number.
# "ps -axo pid=,ppid=,%cpu=,rss=" (benchbar stats) answers from $MOCK_STATE/pstable,
# one "PID PPID %CPU RSS" line per process, when a test wrote one.
if [[ "${1:-}" == "-axo" && "${2:-}" == "pid=,ppid=,%cpu=,rss=" && -f "${MOCK_STATE:-/nonexistent}/pstable" ]]; then
  cat "$MOCK_STATE/pstable"
  exit 0
fi
if [[ "${1:-}" == "-o" && "${2:-}" == "command="&& "${3:-}" == "-p" && -f "${MOCK_STATE:-/nonexistent}/ps/${4:-x}" ]]; then
  cat "${MOCK_STATE}/ps/$4"
  exit 0
fi
if [[ "${1:-}" == "-o" && "${2:-}" == "ppid=,comm=" && "${3:-}" == "-p" && -d "${MOCK_STATE:-/nonexistent}/pstree" ]]; then
  [[ -f "$MOCK_STATE/pstree/${4:-x}" ]] || exit 1
  cat "$MOCK_STATE/pstree/$4"
  exit 0
fi
prev=""
for a in "$@"; do
  if [[ "$prev" == "-p" && "$a" =~ ^[0-9]+$ && -f "${MOCK_STATE:-/nonexistent}/ever_procs" ]]; then
    ! grep -q "^${a} " "$MOCK_STATE/ever_procs" || exit 1
  fi
  prev="$a"
done
exec /bin/ps "$@"
