#!/usr/bin/env bash
# uv mock: "pip install --python <py> honcho" drops a honcho next to <py>
# shellcheck source=tests/mocks/bin/_mocklib.sh
. "$(dirname "$0")/_mocklib.sh"
mock_log "$@"
# uv's executable folder, as "uv tool dir --bin" reports it
bindir="${UV_TOOL_BIN_DIR:-${XDG_BIN_HOME:-$HOME/.local/bin}}"
if [[ "$*" == "tool dir --bin" ]]; then printf '%s\n' "$bindir"; exit 0; fi
# "tool install frappe-bench": a bench in uv's tool folder, linked into the executable folder
if [[ "${1:-} ${2:-}" == "tool install" ]]; then
  tools="${UV_TOOL_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/uv/tools}/${3:-tool}/bin"
  mkdir -p "$tools" "$bindir"
  printf '#!/usr/bin/env bash\nexit 0\n' >"$tools/bench"; chmod +x "$tools/bench"
  ln -sfn "$tools/bench" "$bindir/bench"
  exit 0
fi
py=""
while [[ "$#" -gt 0 ]]; do case "$1" in --python) py="$2"; shift 2 ;; *) shift ;; esac; done
[[ -n "$py" ]] && { cp "$(dirname "$0")/../honcho" "$(dirname "$py")/honcho"; chmod +x "$(dirname "$py")/honcho"; }
exit 0
