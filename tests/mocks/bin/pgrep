#!/usr/bin/env bash
# shellcheck source=tests/mocks/bin/_mocklib.sh
. "$(dirname "$0")/_mocklib.sh"
mock_log "$@"
pattern=""; quiet=0
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -f) pattern="$2"; shift 2 ;;
    -q*) quiet=1; [[ "$1" == *f* ]] && { pattern="$2"; shift; }; shift ;;
    -*) shift ;;
    *) pattern="$1"; shift ;;
  esac
done
found=1
while read -r pid cmdline; do
  [[ -n "$pid" ]] || continue
  if printf '%s' "$cmdline" | grep -qE -- "$pattern"; then [[ "$quiet" == "1" ]] || printf '%s\n' "$pid"; found=0; fi
done <"${MOCK_PROCS:?}"
exit "$found"
